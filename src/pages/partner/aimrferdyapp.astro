---
const title = "Demo AMP - Ai Mr Ferdy";
const description = "Halaman demo AMP Ai Mr Ferdy yang valid untuk Google AMP.";
const canonical = "https://aimrferdy.com/par/demo";
---

<!doctype html>
<html amp lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,minimum-scale=1,initial-scale=1" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="canonical" href={canonical} />

  <script async src="https://cdn.ampproject.org/v0.js"></script>

  <style amp-boilerplate>
    body {
      -webkit-animation: -amp-start 8s steps(1,end) 0s 1 normal both;
      -moz-animation: -amp-start 8s steps(1,end) 0s 1 normal both;
      -ms-animation: -amp-start 8s steps(1,end) 0s 1 normal both;
      animation: -amp-start 8s steps(1,end) 0s 1 normal both;
    }
    @-webkit-keyframes -amp-start {
      from { visibility: hidden; }
      to { visibility: visible; }
    }
    @-moz-keyframes -amp-start {
      from { visibility: hidden; }
      to { visibility: visible; }
    }
    @-ms-keyframes -amp-start {
      from { visibility: hidden; }
      to { visibility: visible; }
    }
    @-o-keyframes -amp-start {
      from { visibility: hidden; }
      to { visibility: visible; }
    }
    @keyframes -amp-start {
      from { visibility: hidden; }
      to { visibility: visible; }
    }
  </style>

  <noscript>
    <style amp-boilerplate>
      body {
        -webkit-animation: none;
        -moz-animation: none;
        -ms-animation: none;
        animation: none;
      }
    </style>
  </noscript>

  <style amp-custom>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      background: #050b14;
      color: #f8fafc;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      min-height: 100vh;
    }

    .container {
      width: min(900px, calc(100% - 32px));
      margin: 0 auto;
      padding: 60px 0;
    }

    .card {
      padding: 32px;
      border: 1px solid #16324f;
      border-radius: 18px;
      background: #0a1422;
    }

    .badge {
      display: inline-block;
      margin-bottom: 16px;
      padding: 7px 12px;
      border-radius: 999px;
      background: #0d3154;
      color: #4db8ff;
      font-size: 12px;
      font-weight: 700;
    }

    h1 {
      margin: 0 0 16px;
      font-size: clamp(32px, 6vw, 56px);
      line-height: 1.1;
    }

    p {
      margin: 0 0 20px;
      color: #a9bdd0;
      font-size: 16px;
      line-height: 1.8;
    }

    .button {
      display: inline-block;
      padding: 13px 20px;
      border-radius: 10px;
      background: #1683ff;
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
    }

    .footer {
      margin-top: 24px;
      color: #6f8498;
      font-size: 12px;
    }
  </style>
</head>

<body>
  <main class="container">
    <article class="card">
      <span class="badge">AMP PAGE</span>

      <h1>Ai Mr Ferdy</h1>

      <p>
        Ini adalah halaman demo AMP mandiri yang dibuat dengan Astro.
        Tidak menggunakan MainLayout dan tidak memanggil stylesheet
        eksternal.
      </p>

      <a class="button" href="https://aimrferdy.com/">
        Kembali ke Ai Mr Ferdy
      </a>

      <div class="footer">
        Ai Mr Ferdy · AI Tools & Digital Platform
      </div>
    </article>
  </main>
</body>
</html>
