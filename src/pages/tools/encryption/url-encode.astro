---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "🔗 URL Encode Decode Online",
  description: "Encode dan decode URL secara online gratis. Ubah karakter khusus menjadi format URL aman.",
  category: "Encryption",
  featured: true
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tools"]}>

<!-- HERO -->
<section class="tool-hero">
  <h1>🔗 URL Encode & Decode Online Gratis</h1>
  <p>
    Encode dan decode URL dengan cepat langsung di browser.
    Cocok untuk developer, SEO, dan penggunaan API.
  </p>
</section>

<!-- APP -->
<section class="tool-box">

  <div class="form-group">
    <label>Input URL / Teks</label>
    <textarea id="input" class="tool-textarea" placeholder="Contoh: https://example.com/?q=halo dunia"></textarea>
  </div>

  <div class="btn-group">
    <button class="btn btn-primary" onclick="encodeURL()">🔒 Encode</button>
    <button class="btn btn-secondary" onclick="decodeURL()">🔓 Decode</button>
  </div>

  <div class="form-group">
    <label>Hasil</label>
    <textarea id="result" class="tool-textarea" placeholder="Hasil akan muncul di sini..."></textarea>
  </div>

  <!-- COPY -->
  <div id="copyWrap" style="display:none; margin-top:10px;">
    <button class="btn btn-secondary" onclick="copyResult()">📋 Copy</button>
  </div>

  <p style="margin-top:15px;">
    <strong>⬇️ Gunakan tool di atas untuk encode atau decode URL</strong>
  </p>

</section>

<!-- SEO CONTENT -->
<section class="tool-seo">

  <h2>Apa Itu URL Encode?</h2>
  <p>
    URL Encode adalah proses mengubah karakter khusus dalam URL menjadi format
    yang aman untuk dikirim melalui internet, seperti spasi menjadi <code>%20</code>.
  </p>

  <h2>Kenapa URL Encode Penting?</h2>
  <ul>
    <li>Mencegah error pada URL</li>
    <li>Digunakan dalam query parameter</li>
    <li>Penting untuk API & tracking link</li>
    <li>Meningkatkan kompatibilitas browser</li>
  </ul>

</section>

<!-- COLLAPSE -->
<section class="tool-more">

  <details open>
    <summary>Cara Menggunakan URL Encode</summary>
    <p>
      Masukkan URL atau teks, lalu klik encode atau decode.
      Hasil akan langsung muncul dan bisa kamu copy.
    </p>
  </details>

  <details>
    <summary>Fitur Tools Ini</summary>
    <ul>
      <li>Encode URL otomatis</li>
      <li>Decode URL dengan cepat</li>
      <li>Proses langsung di browser</li>
      <li>Gratis tanpa login</li>
    </ul>
  </details>

  <details>
    <summary>Kapan Menggunakan URL Encode?</summary>
    <ul>
      <li>Membuat query parameter</li>
      <li>Mengirim data via URL</li>
      <li>Tracking campaign link</li>
      <li>Integrasi API</li>
    </ul>
  </details>

</section>

<script is:inline>
window.encodeURL = function(){
  const input = document.getElementById("input").value;
  const result = document.getElementById("result");

  if(!input){
    alert("Masukkan teks atau URL dulu!");
    document.getElementById("copyWrap").style.display = "none";
    return;
  }

  try{
    result.value = encodeURIComponent(input);
    document.getElementById("copyWrap").style.display = "block";
  } catch(e){
    result.value = "Gagal encode.";
  }
};

window.decodeURL = function(){
  const input = document.getElementById("input").value;
  const result = document.getElementById("result");

  if(!input){
    alert("Masukkan URL encoded dulu!");
    document.getElementById("copyWrap").style.display = "none";
    return;
  }

  try{
    result.value = decodeURIComponent(input);
    document.getElementById("copyWrap").style.display = "block";
  } catch(e){
    result.value = "URL tidak valid.";
  }
};

window.copyResult = function(){
  const text = document.getElementById("result").value;
  const btn = document.querySelector("#copyWrap button");

  if(!text){
    alert("Belum ada hasil!");
    return;
  }

  navigator.clipboard.writeText(text);

  btn.innerText = "✅ Copied!";
  setTimeout(() => {
    btn.innerText = "📋 Copy";
  }, 1500);
};
</script>

</MainLayout>
