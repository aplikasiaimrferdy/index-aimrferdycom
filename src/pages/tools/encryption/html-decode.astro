---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "🔓 HTML Decode Online",
  description: "Decode HTML entities menjadi teks asli secara online gratis. Cepat, aman, dan tanpa install.",
  category: "Encryption",
  featured: false
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tools"]}>

<!-- HERO -->
<section class="tool-hero">
  <h1>🔓 HTML Decode Online Gratis</h1>
  <p>
    Ubah HTML entities menjadi teks asli dengan cepat langsung di browser.
    Gratis, aman, dan tanpa install.
  </p>
</section>

<!-- APP -->
<section class="tool-box">

  <div class="form-group">
    <label>HTML Encoded</label>
    <textarea id="input" class="tool-textarea" placeholder="Contoh: &amp;lt;h1&amp;gt;Hello&amp;lt;/h1&amp;gt;"></textarea>
  </div>

  <div class="btn-group">
    <button class="btn btn-primary" onclick="decodeHTML()">🔓 Decode</button>
  </div>

  <div class="form-group">
    <label>Hasil Decode</label>
    <textarea id="result" class="tool-textarea" placeholder="Hasil akan muncul di sini..."></textarea>
  </div>

  <!-- COPY -->
  <div id="copyWrap" style="display:none; margin-top:10px;">
    <button class="btn btn-secondary" onclick="copyResult()">📋 Copy</button>
  </div>

  <p style="margin-top:15px;">
    <strong>⬇️ Gunakan tool di atas untuk decode HTML</strong>
  </p>

</section>

<!-- SEO CONTENT -->
<section class="tool-seo">

  <h2>Apa Itu HTML Decode?</h2>
  <p>
    HTML Decode adalah proses mengubah HTML entities seperti 
    <code>&amp;lt;</code>, <code>&amp;gt;</code>, dan <code>&amp;amp;</code> 
    kembali menjadi karakter aslinya seperti &lt;, &gt;, dan &amp;.
  </p>

  <h2>Kenapa HTML Decode Dibutuhkan?</h2>
  <ul>
    <li>Menampilkan teks asli dari encoded HTML</li>
    <li>Mempermudah debugging kode</li>
    <li>Membantu developer memahami output data</li>
    <li>Cocok untuk parsing data dari API</li>
  </ul>

</section>

<!-- COLLAPSE -->
<section class="tool-more">

  <details open>
    <summary>Cara Decode HTML</summary>
    <p>
      Masukkan teks HTML yang sudah di-encode, lalu klik tombol decode.
      Hasilnya akan langsung muncul dan bisa kamu copy.
    </p>
  </details>

  <details>
    <summary>Fitur Tools Ini</summary>
    <ul>
      <li>Decode HTML entities</li>
      <li>Proses cepat di browser</li>
      <li>Gratis tanpa login</li>
      <li>Copy hasil sekali klik</li>
    </ul>
  </details>

  <details>
    <summary>Kapan Menggunakan HTML Decode?</summary>
    <ul>
      <li>Debugging output HTML</li>
      <li>Parsing data API</li>
      <li>Menampilkan teks dari database</li>
    </ul>
  </details>

</section>

<script is:inline>
window.decodeHTML = function(){
  const input = document.getElementById("input").value;
  const result = document.getElementById("result");

  if(!input){
    alert("Masukkan HTML encoded dulu!");
    document.getElementById("copyWrap").style.display = "none";
    return;
  }

  const textarea = document.createElement("textarea");
  textarea.innerHTML = input;
  result.value = textarea.value;

  document.getElementById("copyWrap").style.display = "block";
};

window.copyResult = function(){
  const text = document.getElementById("result").value;
  const btn = document.querySelector("#copyWrap button");

  if(!text){
    alert("Belum ada hasil!");
    return;
  }

  navigator.clipboard.writeText(text);

  btn.innerText = "✅ Copied!";
  setTimeout(() => {
    btn.innerText = "📋 Copy";
  }, 1500);
};
</script>

</MainLayout>
