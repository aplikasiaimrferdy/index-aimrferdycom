---
import MainLayout from "../../../layouts/MainLayout.astro";

// ambil semua tools dalam folder social
const modules = Object.entries(
  import.meta.glob('./**/*.astro', { eager: true })
);

// filter hanya category SOCIAL
const tools = modules
  .map(([file, mod]) => {
    if (!mod.meta) return null;

    const url = file
      .replace('/src/pages', '')
      .replace('.astro', '');

    return { url, ...mod.meta };
  })
  .filter(Boolean)
  .filter(t => t.category?.toLowerCase().trim() === "social");

// featured
const featured = tools.filter(t => t.featured);

// stats
const total = tools.length;

// SEO JSON-LD
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Social Media Tools Online Gratis",
  itemListElement: tools.map((tool, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: tool.title,
    url: `https://aimrferdy.net${tool.url}`
  }))
};
---

<MainLayout 
  title="Social Media Tools Online Gratis | AI Mr Ferdy"
  description="Kumpulan tools sosial media gratis: downloader, generator caption, hashtag, dan lainnya tanpa install."
pageCSS={["tools"]}>

<div class="tools-container">

  <!-- HERO -->
  <section class="tools-hero">
    <h1>Social Media Tools Online Gratis</h1>
    <p>Download, generate, dan optimasi konten sosial media dengan mudah.</p>
  </section>

  <!-- STATS -->
  <section class="tools-stats">
    <div><strong>{total}</strong><span>Tools</span></div>
    <div><strong>100%</strong><span>Gratis</span></div>
    <div><strong>Fast</strong><span>No Login</span></div>
  </section>

  <!-- SEARCH -->
  <section class="tools-search">
    <input 
      id="searchTools"
      type="text"
      placeholder="Cari social tools..."
      onInput="filterTools()"
    />
  </section>

  <!-- FEATURED -->
  {featured.length > 0 && (
    <section>
      <h2 class="section-title">🔥 Popular Social Tools</h2>

      <div class="tools-grid">
        {featured.map(tool => (
          <a href={tool.url} class="tool-card popular">
            <div class="badge">HOT</div>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- LIST -->
  <section>
    <h2 class="section-title">📂 Semua Social Tools</h2>

    <div class="tools-grid">
      {tools.map(tool => (
        <a href={tool.url} class="tool-card">
          <h3>{tool.title}</h3>
          <p>{tool.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- EMPTY -->
  <div id="emptyState" class="tools-empty" style="display:none;">
    Tidak ada tools ditemukan
  </div>

  <!-- SEO CONTENT -->
  <section class="seo-content">
    <h2>Apa Itu Social Media Tools?</h2>
    <p>
      Social media tools adalah alat online yang membantu mengelola dan mengoptimasi
      konten di platform seperti Instagram, TikTok, YouTube, dan lainnya.
      Tools ini memudahkan pengguna dalam membuat, mengunduh, dan meningkatkan performa konten.
    </p>

    <h2>Fitur Social Tools yang Populer</h2>
    <ul>
      <li>Video & image downloader</li>
      <li>Caption generator</li>
      <li>Hashtag generator</li>
      <li>Thumbnail downloader</li>
    </ul>

    <h2>Kenapa Menggunakan Social Tools Online?</h2>
    <p>
      Dengan tools dari AI Mr Ferdy, kamu bisa mengelola konten sosial media
      lebih cepat tanpa perlu aplikasi tambahan. Semua tools gratis dan langsung
      bisa digunakan di browser.
    </p>

    <p>
      👉 <a href="/tools">Lihat semua tools lainnya</a>
    </p>
  </section>

</div>

<!-- SCRIPT -->
<script>
window.filterTools = function () {
  const q = document.getElementById("searchTools").value.toLowerCase();
  const cards = document.querySelectorAll(".tool-card");
  let visible = 0;

  cards.forEach(card => {
    const match = card.innerText.toLowerCase().includes(q);
    card.style.display = match ? "block" : "none";
    if (match) visible++;
  });

  document.getElementById("emptyState").style.display = visible ? "none" : "block";
};
</script>

<!-- SEO -->
<script type="application/ld+json">
{JSON.stringify(jsonLd)}
</script>

</MainLayout>
