---
import MainLayout from "../../../layouts/MainLayout.astro";

// ambil semua tools dalam folder kalkulator
const modules = Object.entries(
  import.meta.glob('./**/*.astro', { eager: true })
);

// filter category KALKULATOR
const tools = modules
  .map(([file, mod]) => {
    if (!mod.meta) return null;

    const url = file
      .replace('/src/pages', '')
      .replace('.astro', '');

    return { url, ...mod.meta };
  })
  .filter(Boolean)
  .filter(t => t.category?.toLowerCase().includes("kalkulator"));

// featured
const featured = tools.filter(t => t.featured);

// stats
const total = tools.length;

// SEO JSON-LD
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Kalkulator Online Gratis",
  itemListElement: tools.map((tool, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: tool.title,
    url: `https://aimrferdy.net${tool.url}`
  }))
};
---

<MainLayout 
  title="Kalkulator Online Gratis Lengkap | AI Mr Ferdy"
  description="Kumpulan kalkulator online gratis seperti kalkulator BMI, umur, diskon, dan lainnya langsung di browser."
  pageCSS={["tools"]}>

<div class="tools-container">

  <!-- HERO -->
  <section class="tools-hero">
    <h1>🔢 Kalkulator Online</h1>
    <p>
      Berbagai kalkulator praktis untuk kebutuhan sehari-hari.
    </p>
  </section>

  <!-- STATS -->
  <section class="tools-stats">
    <div><strong>{total}</strong><span>Tools</span></div>
    <div><strong>100%</strong><span>Gratis</span></div>
    <div><strong>Fast</strong><span>No Login</span></div>
  </section>

  <!-- SEARCH -->
  <section class="tools-search">
    <input 
      id="searchTools"
      type="text"
      placeholder="Cari kalkulator..."
      onInput="filterTools()"
    />
  </section>

  <!-- FEATURED -->
  {featured.length > 0 && (
    <section>
      <h2 class="section-title">🔥 Kalkulator Populer</h2>

      <div class="tools-grid">
        {featured.map(tool => (
          <a href={tool.url} class="tool-card popular">
            <div class="badge">HOT</div>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- LIST -->
  <section>
    <h2 class="section-title">📂 Semua Kalkulator</h2>

    <div class="tools-grid">
      {tools.map(tool => (
        <a href={tool.url} class="tool-card">
          <h3>{tool.title}</h3>
          <p>{tool.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- EMPTY -->
  <div id="emptyState" class="tools-empty" style="display:none;">
    Tidak ada kalkulator ditemukan
  </div>

  <!-- SEO CONTENT -->
  <section class="seo-content">

    <h2>Apa Itu Kalkulator Online?</h2>
    <p>
      Kalkulator online adalah alat berbasis web yang digunakan untuk menghitung berbagai hal
      seperti matematika, kesehatan, keuangan, dan lainnya secara cepat dan praktis.
    </p>

    <h2>Jenis Kalkulator yang Tersedia</h2>
    <ul>
      <li>Kalkulator BMI</li>
      <li>Kalkulator Umur</li>
      <li>Kalkulator Diskon</li>
      <li>Kalkulator Keuangan</li>
    </ul>

    <h2>Kenapa Menggunakan Kalkulator Online?</h2>
    <p>
      Dengan kalkulator online, kamu tidak perlu menghitung manual. Semua bisa dilakukan
      dengan cepat, akurat, dan langsung di browser tanpa install aplikasi.
    </p>

    <p>
      👉 <a href="/tools">Lihat semua tools lainnya</a>
    </p>

  </section>

</div>

<!-- SCRIPT -->
<script>
window.filterTools = function () {
  const q = document.getElementById("searchTools").value.toLowerCase();
  const cards = document.querySelectorAll(".tool-card");
  let visible = 0;

  cards.forEach(card => {
    const match = card.innerText.toLowerCase().includes(q);
    card.style.display = match ? "block" : "none";
    if (match) visible++;
  });

  document.getElementById("emptyState").style.display = visible ? "none" : "block";
};
</script>

<!-- SEO -->
<script type="application/ld+json">
{JSON.stringify(jsonLd)}
</script>

</MainLayout>
