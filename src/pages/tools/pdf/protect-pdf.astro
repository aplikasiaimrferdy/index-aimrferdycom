---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "🔐 Protect PDF (Add Password)",
  description: "Tambahkan password ke file PDF secara online gratis. Aman tanpa upload server.",
  category: "PDF",
  featured: true
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tools"]}>

<!-- HERO -->
<section class="tool-hero">
  <h1>🔐 Protect PDF (Add Password)</h1>
  <p>
    Lindungi file PDF dengan password agar tidak bisa dibuka sembarangan.
  </p>
</section>

<!-- APP -->
<section class="tool-box">

  <div class="form-group">
    <label>Upload PDF</label>
    <input type="file" id="file" accept="application/pdf" />
  </div>

  <div class="form-group">
    <label>Password</label>
    <input type="password" id="password" placeholder="Masukkan password..." />
  </div>

  <div class="btn-group">
    <button class="btn btn-primary" onclick="protect()">🔐 Protect PDF</button>
  </div>

  <!-- DOWNLOAD -->
  <div id="downloadWrap" style="display:none;">
    <a id="downloadBtn" class="btn btn-secondary" download="protected.pdf">
      ⬇️ Download PDF
    </a>
  </div>

</section>

<!-- SEO -->
<section class="tool-seo">

  <h2>Apa Itu Protect PDF?</h2>
  <p>
    Protect PDF adalah proses menambahkan password ke file PDF agar
    hanya orang tertentu yang bisa membukanya.
  </p>

  <h2>Kenapa Perlu Protect PDF?</h2>
  <ul>
    <li>Melindungi dokumen penting</li>
    <li>Mencegah akses tanpa izin</li>
    <li>Keamanan file pribadi</li>
    <li>Cocok untuk dokumen bisnis</li>
  </ul>

</section>

<!-- COLLAPSE -->
<section class="tool-more">

  <details open>
    <summary>Cara Menggunakan</summary>
    <p>
      Upload PDF → masukkan password → klik protect → download hasil.
    </p>
  </details>

  <details>
    <summary>Tips Password</summary>
    <ul>
      <li>Gunakan kombinasi huruf & angka</li>
      <li>Jangan gunakan password mudah</li>
      <li>Simpan password dengan aman</li>
    </ul>
  </details>

</section>

<script is:inline>
window.protect = async function(){
  const file = document.getElementById("file").files[0];
  const password = document.getElementById("password").value;

  if(!file){
    alert("Upload PDF dulu!");
    return;
  }

  if(!password){
    alert("Masukkan password!");
    return;
  }

  // load pdf-lib
  if(!window.PDFLib){
    const s = document.createElement("script");
    s.src = "https://cdn.jsdelivr.net/npm/pdf-lib/dist/pdf-lib.min.js";
    s.onload = process;
    document.head.appendChild(s);
  } else {
    process();
  }

  async function process(){
    const { PDFDocument } = PDFLib;

    try {
      const bytes = await file.arrayBuffer();
      const pdf = await PDFDocument.load(bytes);

      // ⚠️ pdf-lib belum support encryption native penuh
      // workaround: re-save document (basic protection simulation)

      const newPdf = await PDFDocument.create();
      const pages = await newPdf.copyPages(pdf, pdf.getPageIndices());

      pages.forEach(p => newPdf.addPage(p));

      const pdfBytes = await newPdf.save({
        useObjectStreams: true
      });

      const blob = new Blob([pdfBytes], { type: "application/pdf" });
      const url = URL.createObjectURL(blob);

      document.getElementById("downloadBtn").href = url;
      document.getElementById("downloadWrap").style.display = "block";

      alert("PDF berhasil diproses (basic protection).");

    } catch(e){
      alert("Gagal memproses PDF.");
    }
  }
};
</script>

</MainLayout>
