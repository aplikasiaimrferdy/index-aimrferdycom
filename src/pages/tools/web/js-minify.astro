---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "⚡ JS Minify Online",
  description: "Minify JavaScript secara online gratis. Hilangkan spasi dan perkecil ukuran file JS dengan cepat.",
  category: "Web",
  featured: true
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tools"]}>

<!-- HERO -->
<section class="tool-hero">
  <h1>⚡ JS Minify Online Gratis</h1>
  <p>
    Perkecil ukuran JavaScript dengan menghapus spasi dan karakter tidak penting.
    Cepat, gratis, dan langsung di browser.
  </p>
</section>

<!-- APP -->
<section class="tool-box">

  <div class="form-group">
    <label>JavaScript Input</label>
    <textarea id="input" class="tool-textarea" placeholder="Masukkan kode JS di sini..."></textarea>
  </div>

  <div class="btn-group">
    <button class="btn btn-primary" onclick="minifyJS()">⚡ Minify</button>
  </div>

  <div class="form-group">
    <label>Hasil Minify</label>
    <textarea id="result" class="tool-textarea" placeholder="Hasil JS minify akan muncul di sini..."></textarea>
  </div>

  <!-- COPY -->
  <div id="copyWrap" style="display:none; margin-top:10px;">
    <button class="btn btn-secondary" onclick="copyResult()">📋 Copy</button>
  </div>

  <p style="margin-top:15px;">
    <strong>⬇️ Gunakan tool di atas untuk memperkecil ukuran JavaScript</strong>
  </p>

</section>

<!-- SEO CONTENT -->
<section class="tool-seo">

  <h2>Apa Itu JS Minify?</h2>
  <p>
    JS Minify adalah proses menghapus spasi, komentar, dan karakter yang tidak diperlukan 
    dari file JavaScript untuk mengurangi ukuran file tanpa mengubah fungsinya.
  </p>

  <h2>Kenapa JS Minify Penting?</h2>
  <ul>
    <li>Mempercepat loading website</li>
    <li>Mengurangi ukuran file JS</li>
    <li>Meningkatkan performa website</li>
    <li>Optimasi SEO & PageSpeed</li>
  </ul>

</section>

<!-- COLLAPSE -->
<section class="tool-more">

  <details open>
    <summary>Cara Minify JavaScript</summary>
    <p>
      Masukkan kode JavaScript, lalu klik tombol Minify.
      Hasil akan langsung muncul dan bisa kamu copy.
    </p>
  </details>

  <details>
    <summary>Fitur Tools Ini</summary>
    <ul>
      <li>Minify JS otomatis</li>
      <li>Hapus komentar & spasi</li>
      <li>Proses cepat di browser</li>
      <li>Gratis tanpa login</li>
    </ul>
  </details>

  <details>
    <summary>Kapan Harus Minify JS?</summary>
    <ul>
      <li>Sebelum deploy website</li>
      <li>Optimasi performa web</li>
      <li>Meningkatkan skor PageSpeed</li>
    </ul>
  </details>

</section>

<script is:inline>
window.minifyJS = function(){
  const input = document.getElementById("input").value;
  const result = document.getElementById("result");

  if(!input){
    alert("Masukkan JavaScript dulu!");
    document.getElementById("copyWrap").style.display = "none";
    return;
  }

  try {
    let js = input;

    // hapus komentar //
    js = js.replace(/\/\/.*$/gm, '');

    // hapus komentar /* */
    js = js.replace(/\/\*[\s\S]*?\*\//g, '');

    // hapus spasi berlebih
    js = js.replace(/\s+/g, ' ');

    // hapus spasi sekitar simbol
    js = js.replace(/\s*([{}();,:=+\-*/<>])\s*/g, '$1');

    result.value = js.trim();

    document.getElementById("copyWrap").style.display = "block";
  } catch(e){
    result.value = "Gagal minify JavaScript.";
  }
};

window.copyResult = function(){
  const text = document.getElementById("result").value;
  const btn = document.querySelector("#copyWrap button");

  if(!text){
    alert("Belum ada hasil!");
    return;
  }

  navigator.clipboard.writeText(text);

  btn.innerText = "✅ Copied!";
  setTimeout(() => {
    btn.innerText = "📋 Copy";
  }, 1500);
};
</script>

</MainLayout>
