---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "👁️ JSON Viewer Online",
  description: "Lihat dan eksplorasi JSON secara visual. Format rapi dengan tampilan tree structure langsung di browser.",
  category: "Web",
  featured: true
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tools"]}>

<!-- HERO -->
<section class="tool-hero">
  <h1>👁️ JSON Viewer Online Gratis</h1>
  <p>
    Lihat JSON dalam tampilan tree yang rapi dan mudah dibaca.
    Gratis, cepat, tanpa install.
  </p>
</section>

<!-- APP -->
<section class="tool-box">

  <div class="form-group">
    <label>JSON Input</label>
    <textarea id="input" class="tool-textarea" placeholder='{"nama":"Ferdy","umur":25}'></textarea>
  </div>

  <div class="btn-group">
    <button class="btn btn-primary" onclick="renderJSON()">👁️ View JSON</button>
  </div>

  <div class="form-group">
    <label>Hasil Viewer</label>
    <div id="viewer" class="tool-result" style="white-space:pre-wrap;"></div>
  </div>

</section>

<!-- SEO CONTENT -->
<section class="tool-seo">

  <h2>Apa Itu JSON Viewer?</h2>
  <p>
    JSON Viewer adalah alat untuk menampilkan data JSON dalam format visual
    yang lebih mudah dibaca dibandingkan teks biasa.
  </p>

  <h2>Kenapa Menggunakan JSON Viewer?</h2>
  <ul>
    <li>Memahami struktur data dengan cepat</li>
    <li>Debugging API lebih mudah</li>
    <li>Melihat nested object dengan jelas</li>
    <li>Lebih nyaman dibanding raw JSON</li>
  </ul>

</section>

<!-- COLLAPSE -->
<section class="tool-more">

  <details open>
    <summary>Cara Menggunakan JSON Viewer</summary>
    <p>
      Masukkan JSON, lalu klik View JSON.
      Data akan ditampilkan dalam format yang lebih mudah dibaca.
    </p>
  </details>

  <details>
    <summary>Fitur Tools Ini</summary>
    <ul>
      <li>Render JSON otomatis</li>
      <li>Format rapi</li>
      <li>Support nested object</li>
      <li>Gratis tanpa login</li>
    </ul>
  </details>

  <details>
    <summary>Kapan Menggunakan JSON Viewer?</summary>
    <ul>
      <li>Debugging API</li>
      <li>Melihat response server</li>
      <li>Analisis data JSON</li>
    </ul>
  </details>

</section>

<script is:inline>
function createTree(obj, indent = 0) {
  let html = "";
  const space = "&nbsp;".repeat(indent * 4);

  for (let key in obj) {
    if (typeof obj[key] === "object" && obj[key] !== null) {
      html += `${space}<strong>${key}</strong>:<br>`;
      html += createTree(obj[key], indent + 1);
    } else {
      html += `${space}<strong>${key}</strong>: ${obj[key]}<br>`;
    }
  }

  return html;
}

window.renderJSON = function(){
  const input = document.getElementById("input").value;
  const viewer = document.getElementById("viewer");

  if(!input){
    alert("Masukkan JSON dulu!");
    viewer.innerHTML = "";
    return;
  }

  try {
    const parsed = JSON.parse(input);
    viewer.innerHTML = createTree(parsed);
  } catch(e){
    viewer.innerHTML = "JSON tidak valid.";
  }
};
</script>

</MainLayout>
