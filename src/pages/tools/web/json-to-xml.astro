---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "🔄 JSON to XML Converter",
  description: "Convert JSON ke XML secara online gratis. Cepat, mudah, dan langsung di browser.",
  category: "Web",
  featured: true
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tools"]}>

<!-- HERO -->
<section class="tool-hero">
  <h1>🔄 JSON to XML Converter Online</h1>
  <p>
    Ubah JSON menjadi XML dengan cepat dan mudah.
    Gratis tanpa install.
  </p>
</section>

<!-- APP -->
<section class="tool-box">

  <div class="form-group">
    <label>JSON Input</label>
    <textarea id="input" class="tool-textarea" placeholder='{"nama":"Ferdy","umur":25}'></textarea>
  </div>

  <div class="btn-group">
    <button class="btn btn-primary" onclick="convert()">🔄 Convert</button>
  </div>

  <div class="form-group">
    <label>Hasil XML</label>
    <textarea id="result" class="tool-textarea" placeholder="Hasil XML akan muncul di sini..."></textarea>
  </div>

  <!-- COPY -->
  <div id="copyWrap" style="display:none;">
    <button class="btn btn-secondary" onclick="copyResult()">📋 Copy</button>
  </div>

  <p style="margin-top:15px;">
    <strong>⬇️ Gunakan tool di atas untuk convert JSON ke XML</strong>
  </p>

</section>

<!-- SEO -->
<section class="tool-seo">

  <h2>Apa Itu JSON to XML?</h2>
  <p>
    JSON to XML adalah proses mengubah format data JSON menjadi XML
    yang sering digunakan dalam sistem lama dan integrasi data.
  </p>

  <h2>Kenapa Perlu Convert ke XML?</h2>
  <ul>
    <li>Integrasi dengan sistem legacy</li>
    <li>Digunakan dalam SOAP API</li>
    <li>Format standar di banyak aplikasi enterprise</li>
    <li>Mendukung struktur data berbasis tag</li>
  </ul>

</section>

<!-- COLLAPSE -->
<section class="tool-more">

  <details open>
    <summary>Cara Menggunakan</summary>
    <p>
      Masukkan JSON, lalu klik convert.
      Hasil XML akan langsung muncul.
    </p>
  </details>

  <details>
    <summary>Fitur Tools Ini</summary>
    <ul>
      <li>Convert JSON ke XML</li>
      <li>Support nested object</li>
      <li>Gratis tanpa login</li>
      <li>Proses cepat</li>
    </ul>
  </details>

  <details>
    <summary>Kapan Digunakan?</summary>
    <ul>
      <li>Integrasi API</li>
      <li>Konversi data</li>
      <li>Penggunaan sistem enterprise</li>
    </ul>
  </details>

</section>

<script is:inline>
function jsonToXml(obj, indent = "") {
  let xml = "";

  for (let key in obj) {
    const value = obj[key];

    if (Array.isArray(value)) {
      value.forEach(item => {
        xml += `${indent}<${key}>` + jsonToXml(item, indent + "  ") + `${indent}</${key}>\n`;
      });
    } else if (typeof value === "object" && value !== null) {
      xml += `${indent}<${key}>\n`;
      xml += jsonToXml(value, indent + "  ");
      xml += `${indent}</${key}>\n`;
    } else {
      xml += `${indent}<${key}>${value}</${key}>\n`;
    }
  }

  return xml;
}

window.convert = function(){
  const input = document.getElementById("input").value;
  const result = document.getElementById("result");

  if(!input){
    alert("Masukkan JSON dulu!");
    document.getElementById("copyWrap").style.display = "none";
    return;
  }

  try {
    const parsed = JSON.parse(input);
    const xml = jsonToXml(parsed);

    result.value = `<root>\n${xml}</root>`;
    document.getElementById("copyWrap").style.display = "block";
  } catch(e){
    result.value = "JSON tidak valid.";
  }
};

window.copyResult = function(){
  const text = document.getElementById("result").value;
  const btn = document.querySelector("#copyWrap button");

  if(!text){
    alert("Belum ada hasil!");
    return;
  }

  navigator.clipboard.writeText(text);

  btn.innerText = "✅ Copied!";
  setTimeout(() => {
    btn.innerText = "📋 Copy";
  }, 1500);
};
</script>

</MainLayout>
