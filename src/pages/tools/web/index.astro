---
import MainLayout from "../../../layouts/MainLayout.astro";

const modules = import.meta.glob("./*.astro", {
  eager: true,
});

const tools = Object.keys(modules)
  .filter((path) => !path.endsWith("/index.astro"))
  .map((path) => {
    const slug = path
      .split("/")
      .pop()
      ?.replace(".astro", "") || "";

    const title = slug
      .replace(/[-_]/g, " ")
      .replace(/\b\w/g, (char) => char.toUpperCase());

    return {
      slug,
      title,
      url: `/tools/web/${slug}/`,
      description: `Tool ${title} online gratis.`,
      icon: "🛠️",
    };
  });
---

<MainLayout
  title="Web Tools Online | AI Mr Ferdy"
  description="Kumpulan web tools online gratis."
>
  <main class="page-tools">

    <header class="tools-header">
      <span>WEB TOOLS</span>

      <h1>Web Tools</h1>

      <p>
        Kumpulan tools online untuk kebutuhan web development.
      </p>
    </header>

    <section class="tools-grid">
      {tools.map((tool) => (
        <a href={tool.url} class="tool-card">

          <div class="tool-icon">
            {tool.icon}
          </div>

          <div>
            <h2>{tool.title}</h2>
            <p>{tool.description}</p>
            <strong>Gunakan Tool →</strong>
          </div>

        </a>
      ))}
    </section>

  </main>
</MainLayout>

<style>
  .page-tools {
    max-width: 1280px;
    margin: auto;
    padding: 110px 24px 40px;
  }

  .tools-header {
    margin-bottom: 40px;
    text-align: center;
  }

  .tools-header span {
    color: var(--primary, #3b82f6);
    font-size: 13px;
    font-weight: 700;
  }

  .tools-header h1 {
    margin: 8px 0;
    color: var(--text, #f8fafc);
    font-size: 42px;
  }

  .tools-header p {
    margin: 0;
    color: var(--soft, #94a3b8);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .tool-card {
    display: flex;
    gap: 16px;
    padding: 22px;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--border, rgba(255,255,255,.08));
    border-radius: 18px;
    background: var(--card, rgba(15,23,42,.72));
    transition: .2s ease;
  }

  .tool-card:hover {
    transform: translateY(-4px);
    border-color: rgba(59,130,246,.4);
  }

  .tool-icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: rgba(59,130,246,.12);
    font-size: 26px;
  }

  .tool-card h2 {
    margin: 0 0 7px;
    color: var(--text, #f8fafc);
    font-size: 18px;
  }

  .tool-card p {
    margin: 0 0 12px;
    color: var(--soft, #94a3b8);
    font-size: 14px;
    line-height: 1.5;
  }

  .tool-card strong {
    color: var(--primary, #3b82f6);
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .page-tools {
      padding: 96px 16px 30px;
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }

    .tools-header h1 {
      font-size: 32px;
    }
  }
</style>
