import MainLayout from "../../../layouts/MainLayout.astro";

const modules = import.meta.glob("./*.astro", {
  eager: true,
});

const tools = Object.entries(modules)
  .filter(([path]) => !path.endsWith("/index.astro"))
  .map(([path, mod]) => {
    const fileName = path.split("/").pop()?.replace(".astro", "") || "";

    return {
      slug: fileName,
      url: `/tools/web/${fileName}/`,
      title: mod.TOOL?.title || fileName,
      description:
        mod.TOOL?.description || `Tool ${fileName} online.`,
      icon: mod.TOOL?.icon || "🛠️",
      featured: mod.TOOL?.featured || false,
    };
  })
  .sort((a, b) => a.title.localeCompare(b.title));
---

<MainLayout
  title="Web Tools Online | AI Mr Ferdy"
  description="Kumpulan web tools online gratis untuk HTML, CSS, JavaScript, JSON, dan kebutuhan pengembangan web."
>
  <main class="page-tools">

    <header class="tools-header">
      <span class="eyebrow">WEB TOOLS</span>

      <h1>Web Tools</h1>

      <p>
        Kumpulan tools online untuk membantu pekerjaan web development
        dengan cepat dan mudah.
      </p>
    </header>

    {tools.length > 0 ? (
      <section class="tools-grid">
        {tools.map((tool) => (
          <a href={tool.url} class="tool-card">

            <div class="tool-icon">
              {tool.icon}
            </div>

            <div class="tool-content">
              <h2>{tool.title}</h2>

              <p>{tool.description}</p>

              <span class="tool-link">
                Gunakan Tool →
              </span>
            </div>

          </a>
        ))}
      </section>
    ) : (
      <div class="empty-state">
        <div>🛠️</div>
        <h2>Belum ada Web Tools</h2>
        <p>
          Tambahkan file .astro di folder
          <code>src/pages/tools/web/</code>.
        </p>
      </div>
    )}

  </main>
</MainLayout>

<style>
