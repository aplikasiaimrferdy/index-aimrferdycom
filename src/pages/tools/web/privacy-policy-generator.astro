---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "🔐 Privacy Policy Generator",
  description: "Buat Privacy Policy untuk website secara otomatis dan gratis. Cocok untuk blog, bisnis, dan aplikasi.",
    category: "Web",
  featured: true
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tools"]}>

<!-- HERO -->
<section class="tool-hero">
  <h1>🔐 Privacy Policy Generator Gratis</h1>
  <p>
    Buat halaman Privacy Policy untuk website kamu dengan mudah.
    Gratis, cepat, dan siap digunakan.
  </p>
</section>

<!-- APP -->
<section class="tool-box">

  <div class="form-group">
    <label>Nama Website</label>
    <input id="site" placeholder="Contoh: aimrferdy.net" />
  </div>

  <div class="form-group">
    <label>Nama Perusahaan / Pemilik</label>
    <input id="company" placeholder="Contoh: AI Mr Ferdy" />
  </div>

  <div class="form-group">
    <label>Email Kontak</label>
    <input id="email" placeholder="Contoh: admin@email.com" />
  </div>

  <div class="form-group">
    <label>Negara</label>
    <input id="country" placeholder="Contoh: Indonesia" />
  </div>

  <div class="btn-group">
    <button class="btn btn-primary" onclick="generatePrivacy()">🚀 Generate</button>
  </div>

  <div class="form-group">
    <label>Hasil Privacy Policy</label>
    <textarea id="result" class="tool-textarea" placeholder="Hasil akan muncul di sini..."></textarea>
  </div>

  <!-- COPY -->
  <div id="copyWrap" style="display:none;">
    <button class="btn btn-secondary" onclick="copyResult()">📋 Copy</button>
  </div>

  <p style="margin-top:15px;">
    <strong>⬇️ Generate Privacy Policy untuk website kamu</strong>
  </p>

</section>

<!-- SEO CONTENT -->
<section class="tool-seo">

  <h2>Apa Itu Privacy Policy?</h2>
  <p>
    Privacy Policy adalah halaman yang menjelaskan bagaimana website kamu
    mengumpulkan, menggunakan, dan melindungi data pengguna.
  </p>

  <h2>Kenapa Privacy Policy Penting?</h2>
  <ul>
    <li>Wajib untuk Google AdSense</li>
    <li>Melindungi data pengguna</li>
    <li>Meningkatkan kepercayaan user</li>
    <li>Persyaratan hukum di banyak negara</li>
  </ul>

</section>

<!-- COLLAPSE -->
<section class="tool-more">

  <details open>
    <summary>Cara Membuat Privacy Policy</summary>
    <p>
      Isi data website kamu, lalu klik generate.
      Hasil bisa langsung kamu copy dan gunakan.
    </p>
  </details>

  <details>
    <summary>Fitur Tools Ini</summary>
    <ul>
      <li>Generate otomatis</li>
      <li>Gratis tanpa login</li>
      <li>Format siap pakai</li>
      <li>Cocok untuk semua website</li>
    </ul>
  </details>

  <details>
    <summary>Tips Penting</summary>
    <ul>
      <li>Sesuaikan dengan layanan website</li>
      <li>Update jika ada perubahan data</li>
      <li>Tambahkan cookie policy jika perlu</li>
    </ul>
  </details>

</section>

<script is:inline>
window.generatePrivacy = function(){
  const site = document.getElementById("site").value || "Website";
  const company = document.getElementById("company").value || "Kami";
  const email = document.getElementById("email").value || "email@domain.com";
  const country = document.getElementById("country").value || "Negara";

  const text = `
Privacy Policy for ${site}

At ${site}, accessible from ${site}, one of our main priorities is the privacy of our visitors.

Information We Collect:
We may collect personal information such as name, email address, and usage data.

How We Use Your Information:
We use the information to provide, operate, and improve our services.

Cookies:
We use cookies to store information about visitors' preferences.

Third Party Privacy Policies:
${site}'s Privacy Policy does not apply to other advertisers or websites.

Consent:
By using our website, you hereby consent to our Privacy Policy.

Changes:
${company} may update this policy from time to time.

Contact:
If you have any questions, contact us at ${email}.

Governing Law:
This policy is governed by the laws of ${country}.
`;

  document.getElementById("result").value = text.trim();
  document.getElementById("copyWrap").style.display = "block";
};

window.copyResult = function(){
  const text = document.getElementById("result").value;
  const btn = document.querySelector("#copyWrap button");

  if(!text){
    alert("Belum ada hasil!");
    return;
  }

  navigator.clipboard.writeText(text);

  btn.innerText = "✅ Copied!";
  setTimeout(() => {
    btn.innerText = "📋 Copy";
  }, 1500);
};
</script>

</MainLayout>
