---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "✨ CSS Beautify Online",
  description: "Format dan rapikan kode CSS secara online gratis. Mudah dibaca, rapi, dan langsung di browser.",
  category: "Web",
  featured: true
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tools"]}>

<!-- HERO -->
<section class="tool-hero">
  <h1>✨ CSS Beautify Online Gratis</h1>
  <p>
    Rapikan dan format kode CSS agar lebih mudah dibaca.
    Gratis, cepat, dan tanpa install.
  </p>
</section>

<!-- APP -->
<section class="tool-box">

  <div class="form-group">
    <label>CSS Input</label>
    <textarea id="input" class="tool-textarea" placeholder="Masukkan kode CSS di sini..."></textarea>
  </div>

  <div class="btn-group">
    <button class="btn btn-primary" onclick="beautifyCSS()">✨ Beautify</button>
  </div>

  <div class="form-group">
    <label>Hasil Beautify</label>
    <textarea id="result" class="tool-textarea" placeholder="Hasil CSS akan rapi di sini..."></textarea>
  </div>

  <!-- COPY -->
  <div id="copyWrap" style="display:none; margin-top:10px;">
    <button class="btn btn-secondary" onclick="copyResult()">📋 Copy</button>
  </div>

  <p style="margin-top:15px;">
    <strong>⬇️ Gunakan tool di atas untuk merapikan kode CSS</strong>
  </p>

</section>

<!-- SEO CONTENT -->
<section class="tool-seo">

  <h2>Apa Itu CSS Beautify?</h2>
  <p>
    CSS Beautify adalah proses merapikan kode CSS dengan menambahkan spasi,
    indentasi, dan baris baru agar mudah dibaca dan dikelola.
  </p>

  <h2>Kenapa CSS Beautify Penting?</h2>
  <ul>
    <li>Membuat kode lebih mudah dibaca</li>
    <li>Mempermudah debugging</li>
    <li>Standarisasi format kode</li>
    <li>Meningkatkan produktivitas developer</li>
  </ul>

</section>

<!-- COLLAPSE -->
<section class="tool-more">

  <details open>
    <summary>Cara Menggunakan CSS Beautify</summary>
    <p>
      Masukkan kode CSS, lalu klik tombol Beautify.
      Hasil akan langsung rapi dan bisa kamu copy.
    </p>
  </details>

  <details>
    <summary>Fitur Tools Ini</summary>
    <ul>
      <li>Format CSS otomatis</li>
      <li>Indentasi rapi</li>
      <li>Proses cepat di browser</li>
      <li>Gratis tanpa login</li>
    </ul>
  </details>

  <details>
    <summary>Kapan Menggunakan CSS Beautify?</summary>
    <ul>
      <li>Membaca kode CSS yang berantakan</li>
      <li>Debugging styling</li>
      <li>Kolaborasi tim developer</li>
    </ul>
  </details>

</section>

<script is:inline>
window.beautifyCSS = function(){
  const input = document.getElementById("input").value;
  const result = document.getElementById("result");

  if(!input){
    alert("Masukkan CSS dulu!");
    document.getElementById("copyWrap").style.display = "none";
    return;
  }

  try {
    let css = input;

    // hapus spasi berlebih dulu
    css = css.replace(/\s+/g, ' ');

    // tambahkan newline setelah {
    css = css.replace(/{/g, " {\n");

    // newline setelah ;
    css = css.replace(/;/g, ";\n");

    // newline sebelum }
    css = css.replace(/}/g, "\n}\n");

    // indentasi sederhana
    let indent = 0;
    const lines = css.split("\n");
    const formatted = lines.map(line => {
      line = line.trim();

      if (line.endsWith("}")) indent--;

      const space = "  ".repeat(Math.max(indent, 0));
      const newLine = space + line;

      if (line.endsWith("{")) indent++;

      return newLine;
    });

    result.value = formatted.join("\n").trim();

    document.getElementById("copyWrap").style.display = "block";
  } catch(e){
    result.value = "Gagal beautify CSS.";
  }
};

window.copyResult = function(){
  const text = document.getElementById("result").value;
  const btn = document.querySelector("#copyWrap button");

  if(!text){
    alert("Belum ada hasil!");
    return;
  }

  navigator.clipboard.writeText(text);

  btn.innerText = "✅ Copied!";
  setTimeout(() => {
    btn.innerText = "📋 Copy";
  }, 1500);
};
</script>

</MainLayout>
