---
import MainLayout from "../../../layouts/MainLayout.astro";

const title = "Tes Tool";
const description = "Halaman testing tool AI Mr Ferdy.";
---

<MainLayout
  title={`${title} | AI Mr Ferdy`}
  description={description}
>
  <main class="page-tools">
    <h1>{title}</h1>
    <p>{description}</p>

    <div class="test-box">
      <h2>Test berhasil</h2>
      <p>Halaman /tools/web/tes/ berhasil dibuat.</p>
    </div>
  </main>
</MainLayout>

<style>
  .page-tools {
    max-width: 1280px;
    margin: auto;
    padding: 110px 24px 40px;
  }

  h1,
  h2 {
    color: var(--text, #f8fafc);
  }

  p {
    color: var(--soft, #94a3b8);
  }

  .test-box {
    margin-top: 24px;
    padding: 24px;
    border: 1px solid var(--border, rgba(255,255,255,.08));
    border-radius: 16px;
    background: var(--card, rgba(15,23,42,.72));
  }
</style>
