---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "✨ JSON Beautify Online",
  description: "Format dan rapikan JSON secara online gratis. Mudah dibaca dan langsung di browser.",
  category: "Web",
  featured: true
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tools"]}>

<!-- HERO -->
<section class="tool-hero">
  <h1>✨ JSON Beautify Online Gratis</h1>
  <p>
    Rapikan dan format JSON agar lebih mudah dibaca.
    Cepat, gratis, dan tanpa install.
  </p>
</section>

<!-- APP -->
<section class="tool-box">

  <div class="form-group">
    <label>JSON Input</label>
    <textarea id="input" class="tool-textarea" placeholder='Contoh: {"nama":"Ferdy","umur":25}'></textarea>
  </div>

  <div class="btn-group">
    <button class="btn btn-primary" onclick="beautifyJSON()">✨ Beautify</button>
  </div>

  <div class="form-group">
    <label>Hasil Beautify</label>
    <textarea id="result" class="tool-textarea" placeholder="Hasil JSON akan rapi di sini..."></textarea>
  </div>

  <!-- COPY -->
  <div id="copyWrap" style="display:none; margin-top:10px;">
    <button class="btn btn-secondary" onclick="copyResult()">📋 Copy</button>
  </div>

  <p style="margin-top:15px;">
    <strong>⬇️ Gunakan tool di atas untuk merapikan JSON</strong>
  </p>

</section>

<!-- SEO CONTENT -->
<section class="tool-seo">

  <h2>Apa Itu JSON Beautify?</h2>
  <p>
    JSON Beautify adalah proses merapikan struktur JSON dengan indentasi dan line break
    agar mudah dibaca dan dipahami.
  </p>

  <h2>Kenapa JSON Beautify Penting?</h2>
  <ul>
    <li>Membuat JSON lebih readable</li>
    <li>Mempermudah debugging API</li>
    <li>Meningkatkan produktivitas developer</li>
    <li>Memahami struktur data lebih cepat</li>
  </ul>

</section>

<!-- COLLAPSE -->
<section class="tool-more">

  <details open>
    <summary>Cara Menggunakan JSON Beautify</summary>
    <p>
      Masukkan JSON, lalu klik tombol Beautify.
      Hasil akan langsung rapi dan bisa kamu copy.
    </p>
  </details>

  <details>
    <summary>Fitur Tools Ini</summary>
    <ul>
      <li>Format JSON otomatis</li>
      <li>Indentasi rapi</li>
      <li>Validasi JSON dasar</li>
      <li>Gratis tanpa login</li>
    </ul>
  </details>

  <details>
    <summary>Kapan Menggunakan JSON Beautify?</summary>
    <ul>
      <li>Membaca response API</li>
      <li>Debugging data JSON</li>
      <li>Analisis struktur data</li>
    </ul>
  </details>

</section>

<script is:inline>
window.beautifyJSON = function(){
  const input = document.getElementById("input").value;
  const result = document.getElementById("result");

  if(!input){
    alert("Masukkan JSON dulu!");
    document.getElementById("copyWrap").style.display = "none";
    return;
  }

  try {
    const parsed = JSON.parse(input);
    result.value = JSON.stringify(parsed, null, 2); // indent 2 spasi
    document.getElementById("copyWrap").style.display = "block";
  } catch(e){
    result.value = "JSON tidak valid.";
  }
};

window.copyResult = function(){
  const text = document.getElementById("result").value;
  const btn = document.querySelector("#copyWrap button");

  if(!text){
    alert("Belum ada hasil!");
    return;
  }

  navigator.clipboard.writeText(text);

  btn.innerText = "✅ Copied!";
  setTimeout(() => {
    btn.innerText = "📋 Copy";
  }, 1500);
};
</script>

</MainLayout>
