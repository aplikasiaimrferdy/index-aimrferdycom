---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "⚡ JSON Minify Online",
  description: "Minify JSON secara online gratis. Hilangkan spasi untuk memperkecil ukuran JSON dengan cepat.",
  category: "Web",
  featured: true
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tools"]}>

<!-- HERO -->
<section class="tool-hero">
  <h1>⚡ JSON Minify Online Gratis</h1>
  <p>
    Perkecil ukuran JSON dengan menghapus spasi dan format tidak perlu.
    Cepat, gratis, dan langsung di browser.
  </p>
</section>

<!-- APP -->
<section class="tool-box">

  <div class="form-group">
    <label>JSON Input</label>
    <textarea id="input" class="tool-textarea" placeholder='Contoh: { "nama": "Ferdy", "umur": 25 }'></textarea>
  </div>

  <div class="btn-group">
    <button class="btn btn-primary" onclick="minifyJSON()">⚡ Minify</button>
  </div>

  <div class="form-group">
    <label>Hasil Minify</label>
    <textarea id="result" class="tool-textarea" placeholder="Hasil JSON minify akan muncul di sini..."></textarea>
  </div>

  <!-- COPY -->
  <div id="copyWrap" style="display:none; margin-top:10px;">
    <button class="btn btn-secondary" onclick="copyResult()">📋 Copy</button>
  </div>

  <p style="margin-top:15px;">
    <strong>⬇️ Gunakan tool di atas untuk memperkecil ukuran JSON</strong>
  </p>

</section>

<!-- SEO CONTENT -->
<section class="tool-seo">

  <h2>Apa Itu JSON Minify?</h2>
  <p>
    JSON Minify adalah proses menghapus spasi, tab, dan line break dari JSON
    untuk membuat ukuran file lebih kecil tanpa mengubah data.
  </p>

  <h2>Kenapa JSON Minify Penting?</h2>
  <ul>
    <li>Mengurangi ukuran data API</li>
    <li>Mempercepat loading aplikasi</li>
    <li>Optimasi bandwidth</li>
    <li>Meningkatkan performa web</li>
  </ul>

</section>

<!-- COLLAPSE -->
<section class="tool-more">

  <details open>
    <summary>Cara Minify JSON</summary>
    <p>
      Masukkan JSON, lalu klik tombol Minify.
      Hasil akan langsung muncul dan bisa kamu copy.
    </p>
  </details>

  <details>
    <summary>Fitur Tools Ini</summary>
    <ul>
      <li>Minify JSON otomatis</li>
      <li>Validasi JSON dasar</li>
      <li>Proses cepat di browser</li>
      <li>Gratis tanpa login</li>
    </ul>
  </details>

  <details>
    <summary>Kapan Harus Minify JSON?</summary>
    <ul>
      <li>Optimasi API response</li>
      <li>Pengiriman data lebih ringan</li>
      <li>Produksi aplikasi web</li>
    </ul>
  </details>

</section>

<script is:inline>
window.minifyJSON = function(){
  const input = document.getElementById("input").value;
  const result = document.getElementById("result");

  if(!input){
    alert("Masukkan JSON dulu!");
    document.getElementById("copyWrap").style.display = "none";
    return;
  }

  try {
    const parsed = JSON.parse(input);
    result.value = JSON.stringify(parsed);
    document.getElementById("copyWrap").style.display = "block";
  } catch(e){
    result.value = "JSON tidak valid.";
  }
};

window.copyResult = function(){
  const text = document.getElementById("result").value;
  const btn = document.querySelector("#copyWrap button");

  if(!text){
    alert("Belum ada hasil!");
    return;
  }

  navigator.clipboard.writeText(text);

  btn.innerText = "✅ Copied!";
  setTimeout(() => {
    btn.innerText = "📋 Copy";
  }, 1500);
};
</script>

</MainLayout>
