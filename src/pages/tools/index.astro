
---
import MainLayout from "../../layouts/MainLayout.astro";
import { SITE } from "../../lib/site";

/* LOAD ALL TOOLS */
const modules = Object.entries(
  import.meta.glob("./**/*.astro", {
    eager: true,
  })
);

/* BUILD TOOL LIST */
const tools = modules
  .map(([file, mod]) => {
    const match = file.match(
      /^\.\/([^/]+)\/(.+)\.astro$/
    );

    if (!match) return null;

    const category = match[1];
    const slug = match[2];

    if (
      category === "[category]" ||
      slug === "index"
    ) {
      return null;
    }

    if (!mod.meta) return null;

    return {
      ...mod.meta,
      category,
      slug,
      url: `/tools/${category}/${slug}/`,
    };
  })
  .filter(Boolean)
  .sort((a, b) =>
    (a.title || "").localeCompare(
      b.title || "",
      "id"
    )
  );

/* STATS */
const totalTools = tools.length;

const totalCategories = new Set(
  tools.map((tool) => tool.category)
).size;

/* SEO */
const pageUrl = SITE.url("/tools/");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `Tools | ${SITE.title}`,
  description:
    "Kumpulan AI tools dan utility online yang dapat digunakan langsung dari browser.",
  url: pageUrl,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: totalTools,
    itemListElement: tools.map((tool, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: tool.title,
      url: SITE.url(tool.url),
    })),
  },
};
---

<MainLayout
  title={`Tools | ${SITE.title}`}
  description="Kumpulan AI tools dan utility online yang dapat digunakan langsung dari browser."
>
  <section class="tools-page">
    <header class="tool-header">
      <span class="page-badge">AI TOOLS</span>

      <h1>Tools Online</h1>

      <p>
        Kumpulan AI tools dan utility online yang dapat
        digunakan langsung dari browser.
      </p>
    </header>

    <section
      class="tools-stats"
      aria-label="Statistik tools"
    >
      <div>
        <strong>{totalTools}</strong>
        <span>Tools</span>
      </div>

      <div>
        <strong>{totalCategories}</strong>
        <span>Kategori</span>
      </div>

      <div>
        <strong>100%</strong>
        <span>Gratis</span>
      </div>
    </section>

    <div class="tools-search">
      <label for="toolSearch" class="tool-field-label">
        Cari tools
      </label>

      <input
        id="toolSearch"
        type="search"
        placeholder="Cari nama tools, kategori, atau fungsi..."
        autocomplete="off"
        spellcheck="false"
      />
    </div>

    {tools.length > 0 ? (
      <section
        class="tools-section"
        aria-labelledby="tools-title"
      >
        <div class="section-heading">
          <h2 id="tools-title">Semua Tools</h2>

          <span class="tool-count">
            <span id="visibleToolCount">{totalTools}</span>
            {" "}dari {totalTools} tools
          </span>
        </div>

        <div id="toolsGrid" class="tools-grid">
          {tools.map((tool) => (
            <article
              class="tool-card"
              data-search={`${tool.title || ""} ${tool.description || ""} ${tool.category || ""} ${tool.slug || ""}`}
            >
              {tool.featured && (
                <span class="badge">HOT</span>
              )}

              {tool.icon && (
                <div
                  class="tool-icon"
                  aria-hidden="true"
                >
                  {tool.icon}
                </div>
              )}

              <div class="tool-category">
                {tool.category
                  .replace(/[-_]/g, " ")
                  .replace(/\b\w/g, (char) =>
                    char.toUpperCase()
                  )}
              </div>

              <h3>
                <a href={tool.url}>
                  {tool.title}
                </a>
              </h3>

              {tool.description && (
                <p>{tool.description}</p>
              )}

              <a
                href={tool.url}
                class="btn btn-primary"
                aria-label={`Buka ${tool.title}`}
              >
                Buka Tool
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>

        <div
          id="emptyState"
          class="tools-empty"
          hidden
        >
          <strong>Tool tidak ditemukan</strong>
          <p>
            Coba kata kunci lain atau gunakan nama kategori.
          </p>
        </div>
      </section>
    ) : (
      <div class="tools-empty">
        <strong>Belum ada tools</strong>
        <p>Belum ada file tool yang tersedia.</p>
      </div>
    )}
  </section>

  <script>
    const searchInput =
      document.querySelector<HTMLInputElement>(
        "#toolSearch"
      );

    const cards =
      document.querySelectorAll<HTMLElement>(
        ".tool-card"
      );

    const emptyState =
      document.querySelector<HTMLElement>(
        "#emptyState"
      );

    const visibleToolCount =
      document.querySelector<HTMLElement>(
        "#visibleToolCount"
      );

    const normalizeText = (value: string) =>
      value
        .toLocaleLowerCase("id")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .trim();

    searchInput?.addEventListener("input", () => {
      const query = normalizeText(searchInput.value);
      let visible = 0;

      cards.forEach((card) => {
        const searchableText = normalizeText(
          `${card.dataset.search || ""} ${card.textContent || ""}`
        );

        const matches = searchableText.includes(query);

        card.hidden = !matches;

        if (matches) visible++;
      });

      if (emptyState) {
        emptyState.hidden = visible > 0;
      }

      if (visibleToolCount) {
        visibleToolCount.textContent = String(visible);
      }
    });
  </script>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <style>
    .tools-page {
      width: min(100% - 32px, 1200px);
      margin-inline: auto;
      padding-block: 32px 64px;
      color: var(--text, #f8fafc);
    }

    .tool-header {
      margin-bottom: 28px;
      text-align: center;
    }

    .page-badge {
      display: inline-flex;
      align-items: center;
      padding: 6px 12px;
      border: 1px solid rgba(56, 189, 248, 0.3);
      border-radius: 999px;
      background: rgba(14, 165, 233, 0.1);
      color: #38bdf8;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
    }

    .tool-header h1 {
      margin: 16px 0 10px;
      font-size: clamp(2rem, 5vw, 3.25rem);
      line-height: 1.15;
      letter-spacing: -0.04em;
    }

    .tool-header p {
      max-width: 680px;
      margin: 0 auto;
      color: var(--soft, #94a3b8);
      line-height: 1.75;
    }

    .tools-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      margin: 28px 0;
    }

    .tools-stats > div {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      padding: 20px 12px;
      border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
      border-radius: 16px;
      background: var(--card, rgba(15, 23, 42, 0.72));
      text-align: center;
    }

    .tools-stats strong {
      color: #38bdf8;
      font-size: clamp(1.4rem, 3vw, 2rem);
      line-height: 1.2;
    }

    .tools-stats span {
      color: var(--soft, #94a3b8);
      font-size: 0.875rem;
    }

    .tools-search {
      max-width: 720px;
      margin: 0 auto 36px;
    }

    .tool-field-label {
      display: block;
      margin-bottom: 10px;
      font-size: 0.9rem;
      font-weight: 600;
    }

    .tools-search input {
      display: block;
      width: 100%;
      min-height: 52px;
      padding: 13px 16px;
      border: 1px solid var(--border, rgba(255, 255, 255, 0.12));
      border-radius: 12px;
      outline: none;
      background: var(--card, rgba(15, 23, 42, 0.72));
      color: var(--text, #f8fafc);
      font: inherit;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .tools-search input::placeholder {
      color: var(--soft, #94a3b8);
      opacity: 0.8;
    }

    .tools-search input:focus {
      border-color: #38bdf8;
      box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.12);
    }

    .section-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 20px;
    }

    .section-heading h2 {
      margin: 0;
      font-size: clamp(1.25rem, 3vw, 1.65rem);
      line-height: 1.3;
    }

    .tool-count {
      color: var(--soft, #94a3b8);
      font-size: 0.85rem;
      white-space: nowrap;
    }

    .tools-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }

    .tool-card {
      position: relative;
      display: flex;
      min-width: 0;
      flex-direction: column;
      align-items: flex-start;
      padding: 22px;
      border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
      border-radius: 16px;
      background: var(--card, rgba(15, 23, 42, 0.72));
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    }

    .tool-card:hover {
      transform: translateY(-3px);
      border-color: rgba(56, 189, 248, 0.45);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    }

    .tool-card[hidden],
    .tools-empty[hidden] {
      display: none !important;
    }

    .tool-card .badge {
      position: absolute;
      top: 14px;
      right: 14px;
      padding: 4px 8px;
      border-radius: 6px;
      background: rgba(14, 165, 233, 0.14);
      color: #38bdf8;
      font-size: 0.7rem;
      font-weight: 700;
    }

    .tool-icon {
      display: grid;
      width: 46px;
      height: 46px;
      margin-bottom: 16px;
      place-items: center;
      border: 1px solid rgba(56, 189, 248, 0.2);
      border-radius: 12px;
      background: rgba(14, 165, 233, 0.1);
      font-size: 1.5rem;
    }

    .tool-category {
      margin-bottom: 8px;
      color: #38bdf8;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .tool-card h3 {
      margin: 0 0 10px;
      font-size: 1.1rem;
      line-height: 1.45;
    }

    .tool-card h3 a {
      color: var(--text, #f8fafc);
      text-decoration: none;
      overflow-wrap: anywhere;
    }

    .tool-card h3 a:hover {
      color: #38bdf8;
    }

    .tool-card p {
      flex: 1;
      margin: 0 0 20px;
      color: var(--soft, #94a3b8);
      font-size: 0.9rem;
      line-height: 1.7;
    }

    .tool-card .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 42px;
      padding: 10px 15px;
      border: 1px solid rgba(56, 189, 248, 0.35);
      border-radius: 10px;
      background: rgba(14, 165, 233, 0.12);
      color: #38bdf8;
      font-size: 0.875rem;
      font-weight: 700;
      text-decoration: none;
      transition: background 0.2s, color 0.2s;
    }

    .tool-card .btn:hover {
      background: #0284c7;
      color: #fff;
    }

    .tools-empty {
      margin-top: 20px;
      padding: 28px 20px;
      border: 1px dashed var(--border, rgba(255, 255, 255, 0.15));
      border-radius: 14px;
      color: var(--text, #f8fafc);
      text-align: center;
    }

    .tools-empty strong {
      display: block;
      margin-bottom: 8px;
    }

    .tools-empty p {
      margin: 0;
      color: var(--soft, #94a3b8);
      line-height: 1.6;
    }

    @media (max-width: 900px) {
      .tools-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }

      .tool-card {
        padding: 18px;
      }
    }

    @media (max-width: 560px) {
      .tools-page {
        width: min(100% - 24px, 1200px);
        padding-block: 24px 44px;
      }

      .tools-stats {
        gap: 8px;
        margin: 22px 0;
      }

      .tools-stats > div {
        padding: 15px 6px;
        border-radius: 12px;
      }

      .tools-stats span {
        font-size: 0.78rem;
      }

      .tools-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 14px;
      }

      .section-heading {
        align-items: flex-start;
      }

      .tool-card {
        padding: 20px;
      }
    }
  </style>
</MainLayout>
