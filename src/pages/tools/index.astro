
---
import MainLayout from "../../layouts/MainLayout.astro";
import { SITE } from "../../lib/site";

/* =========================================================
   LOAD ALL TOOLS
========================================================= */

const modules = Object.entries(
  import.meta.glob("./**/*.astro", {
    eager: true,
  })
);

/* =========================================================
   BUILD TOOL LIST
========================================================= */

const tools = modules
  .map(([file, mod]) => {
    const match = file.match(/^\.\/([^/]+)\/(.+)\.astro$/);

    if (!match) return null;

    const category = match[1];
    const slug = match[2];

    if (
      category.startsWith("[") ||
      slug === "index" ||
      slug.includes("[")
    ) {
      return null;
    }

    if (!mod.meta || typeof mod.meta !== "object") {
      return null;
    }

    const meta = mod.meta;

    const keywords = Array.isArray(meta.keywords)
      ? meta.keywords.join(" ")
      : typeof meta.keywords === "string"
        ? meta.keywords
        : "";

    return {
      ...meta,
      title: meta.title || slug.replace(/[-_]/g, " "),
      description: meta.description || "",
      category,
      slug,
      url: `/tools/${category}/${slug}/`,
      searchText: [
        meta.title || "",
        meta.description || "",
        meta.category || "",
        category,
        slug,
        keywords,
      ]
        .join(" ")
        .toLocaleLowerCase("id"),
    };
  })
  .filter(Boolean)
  .sort((a, b) =>
    a.title.localeCompare(b.title, "id")
  );

/* =========================================================
   STATS
========================================================= */

const totalTools = tools.length;

const totalCategories = new Set(
  tools.map((tool) => tool.category)
).size;

/* =========================================================
   SEO
========================================================= */

const pageUrl = SITE.url("/tools/");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `Tools | ${SITE.title}`,
  description:
    "Kumpulan AI tools dan utility online yang dapat digunakan langsung dari browser.",
  url: pageUrl,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: totalTools,
    itemListElement: tools.map((tool, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: tool.title,
      url: SITE.url(tool.url),
    })),
  },
};
---

<MainLayout
  title={`Tools | ${SITE.title}`}
  description="Kumpulan AI tools dan utility online yang dapat digunakan langsung dari browser."
>
  <section class="tools-page">
    <!-- HEADER -->
    <header class="tool-header">
      <span class="page-badge">AI TOOLS</span>

      <h1>Tools Online</h1>

      <p>
        Kumpulan AI tools dan utility online yang dapat digunakan
        langsung dari browser.
      </p>
    </header>

    <!-- STATS -->
    <section class="tools-stats" aria-label="Statistik tools">
      <div>
        <strong>{totalTools}</strong>
        <span>Tools</span>
      </div>

      <div>
        <strong>{totalCategories}</strong>
        <span>Kategori</span>
      </div>

      <div>
        <strong>100%</strong>
        <span>Gratis</span>
      </div>
    </section>

    <!-- SEARCH -->
    <div class="tools-search">
      <label for="toolSearch" class="tool-field-label">
        Cari tools
      </label>

      <input
        id="toolSearch"
        type="search"
        placeholder="Cari judul, kategori, atau fungsi tools..."
        autocomplete="off"
        spellcheck="false"
        aria-label="Cari AI tools"
      />
    </div>

    <!-- TOOLS -->
    {tools.length > 0 ? (
      <section
        class="tools-section"
        aria-labelledby="tools-title"
      >
        <div class="section-heading">
          <h2 id="tools-title">Semua Tools</h2>

          <span class="tool-count" id="toolCount">
            {totalTools} tools
          </span>
        </div>

        <div id="toolsGrid" class="tools-grid">
          {tools.map((tool) => (
            <article
              class="tool-card"
              data-search={tool.searchText}
            >
              {tool.featured && <span class="badge">HOT</span>}

              {tool.icon && (
                <div class="tool-icon" aria-hidden="true">
                  {tool.icon}
                </div>
              )}

              <div class="tool-category">
                {tool.category
                  .replace(/[-_]/g, " ")
                  .replace(/\b\w/g, (char) => char.toUpperCase())}
              </div>

              <h3>
                <a href={tool.url}>{tool.title}</a>
              </h3>

              {tool.description && <p>{tool.description}</p>}

              <a
                href={tool.url}
                class="btn btn-primary"
                aria-label={`Buka ${tool.title}`}
              >
                Buka Tool
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>

        <!-- EMPTY SEARCH -->
        <div id="emptyState" class="tools-empty" hidden>
          <strong>Tool tidak ditemukan</strong>

          <p>
            Coba gunakan kata kunci pencarian lainnya.
          </p>
        </div>
      </section>
    ) : (
      <div class="tools-empty">
        <strong>Belum ada tools</strong>

        <p>
          Tidak ada halaman tools dengan metadata yang berhasil dibaca.
        </p>
      </div>
    )}
  </section>

  <!-- SEARCH SCRIPT -->
  <script>
    const searchInput =
      document.querySelector("#toolSearch");

    const cards =
      document.querySelectorAll(".tool-card");

    const emptyState =
      document.querySelector("#emptyState");

    const toolCount =
      document.querySelector("#toolCount");

    function normalizeText(value) {
      return (value || "")
        .toLocaleLowerCase("id")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .trim();
    }

    function runSearch() {
      if (!searchInput) return;

      const query = normalizeText(searchInput.value);
      let visible = 0;

      cards.forEach((card) => {
        const text = normalizeText(
          `${card.dataset.search || ""} ${card.textContent || ""}`
        );

        const matches =
          query === "" || text.includes(query);

        card.hidden = !matches;

        if (matches) visible++;
      });

      if (emptyState) {
        emptyState.hidden = visible !== 0;
      }

      if (toolCount) {
        toolCount.textContent =
          query === ""
            ? `${cards.length} tools`
            : `${visible} dari ${cards.length} tools`;
      }
    }

    searchInput?.addEventListener("input", runSearch);
  </script>

  <!-- JSON-LD -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
</MainLayout>
