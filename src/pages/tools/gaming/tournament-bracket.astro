---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "Tournament Bracket Generator Online",
  description: "Buat bracket turnamen secara otomatis untuk game, esport, atau event dengan sistem single elimination.",
  category: "Gaming",
  featured: false
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tools"]}>

<div class="container tools-page">

<h1>🏆 Tournament Bracket Generator</h1>

<p class="tools-sub">
Buat bracket turnamen otomatis untuk mabar, scrim, atau event esports.
</p>

<div class="tool-box">

<textarea id="players" placeholder="Masukkan nama peserta (satu per baris)" class="tool-input"></textarea>

<button class="btn-primary" onclick="generateBracket()">
Generate Bracket
</button>

</div>

<div id="result" class="tool-result">
Bracket akan muncul di sini...
</div>


<!-- SEO CONTENT -->
<section class="tool-seo">

  <h2>Apa Itu Tournament Bracket Generator?</h2>
  <p>
    Tournament Bracket Generator adalah tools online untuk membuat struktur pertandingan secara otomatis.
    Tools ini biasanya digunakan dalam turnamen game, esport, maupun kompetisi komunitas.
  </p>

  <h2>Kenapa Bracket Penting dalam Turnamen?</h2>
  <ul>
    <li>Menyusun alur pertandingan dengan jelas</li>
    <li>Mempermudah pengelolaan turnamen</li>
    <li>Menghindari kebingungan peserta</li>
    <li>Membuat kompetisi lebih profesional</li>
  </ul>

  <h2>Sistem Single Elimination</h2>
  <p>
    Dalam sistem ini, peserta yang kalah langsung gugur. Sistem ini cepat dan sering digunakan dalam turnamen kecil hingga menengah.
  </p>

</section>

<!-- COLLAPSE -->
<section class="tool-more">

  <details open>
    <summary>Cara Menggunakan Tournament Bracket</summary>
    <ul>
      <li>Masukkan nama semua peserta</li>
      <li>Klik tombol generate</li>
      <li>Lihat bracket pertandingan</li>
    </ul>
  </details>

  <details>
    <summary>Fitur Tools Ini</summary>
    <ul>
      <li>Generate bracket otomatis</li>
      <li>Support banyak peserta</li>
      <li>Sistem single elimination</li>
      <li>Gratis tanpa login</li>
      <li>Berjalan langsung di browser</li>
    </ul>
  </details>

  <details>
    <summary>Kapan Harus Menggunakan Tools Ini?</summary>
    <ul>
      <li>Membuat turnamen game</li>
      <li>Event komunitas</li>
      <li>Scrim antar tim</li>
    </ul>
  </details>

</section>

</div>


<script is:inline>
function shuffle(arr) {
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

function nextPowerOfTwo(n){
  return Math.pow(2, Math.ceil(Math.log2(n)));
}

function generateBracket(){
  const input = document.getElementById("players").value.trim();
  const resultBox = document.getElementById("result");

  if (!input) {
    resultBox.innerHTML = "❌ Masukkan peserta terlebih dahulu.";
    return;
  }

  let players = input.split("\n").map(p => p.trim()).filter(p => p);

  if (players.length < 2) {
    resultBox.innerHTML = "❌ Minimal 2 peserta.";
    return;
  }

  players = shuffle(players);

  const size = nextPowerOfTwo(players.length);
  while(players.length < size){
    players.push("BYE");
  }

  let rounds = [];
  rounds.push(players);

  while (rounds[rounds.length - 1].length > 1) {
    const prev = rounds[rounds.length - 1];
    let next = [];
    for (let i = 0; i < prev.length; i += 2) {
      next.push("TBD");
    }
    rounds.push(next);
  }

  let html = "";

  rounds.forEach((round, rIndex) => {
    html += `<div style="margin-bottom:15px;">
      <b>Round ${rIndex + 1}</b><br>`;
    
    for (let i = 0; i < round.length; i += 2) {
      if (round[i+1]) {
        html += `
          ${round[i]} vs ${round[i+1]}<br>
        `;
      } else {
        html += `${round[i]}<br>`;
      }
    }

    html += `</div>`;
  });

  resultBox.innerHTML = html;
}
</script>

</MainLayout>
