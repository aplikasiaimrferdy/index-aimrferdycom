---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "🖼️ PNG to JPG Converter",
  description: "Convert gambar PNG ke JPG secara online gratis. Cepat, tanpa install, langsung di browser.",
  category: "Image",
  featured: true
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tools"]}>

<!-- HERO -->
<section class="tool-hero">
  <h1>🖼️ PNG to JPG Converter Online</h1>
  <p>
    Ubah gambar PNG ke JPG dengan cepat dan mudah.
    Gratis tanpa install dan langsung di browser.
  </p>
</section>

<!-- APP -->
<section class="tool-box">

  <div class="form-group">
    <label>Upload PNG</label>
    <input type="file" id="file" accept="image/png" />
  </div>

  <div class="btn-group">
    <button class="btn btn-primary" onclick="convert()">🔄 Convert to JPG</button>
  </div>

  <!-- PREVIEW -->
  <div class="form-group">
    <label>Preview</label>
    <canvas id="canvas" class="tool-result"></canvas>
  </div>

  <!-- DOWNLOAD -->
  <div id="downloadWrap" style="display:none;">
    <a id="downloadBtn" class="btn btn-secondary" download="image.jpg">⬇️ Download JPG</a>
  </div>

  <p style="margin-top:15px;">
    <strong>⬇️ Upload PNG lalu convert ke JPG</strong>
  </p>

</section>

<!-- SEO -->
<section class="tool-seo">

  <h2>Apa Itu PNG ke JPG?</h2>
  <p>
    PNG ke JPG adalah proses mengubah format gambar PNG menjadi JPG
    agar ukuran file lebih kecil dan kompatibel di berbagai platform.
  </p>

  <h2>Kenapa Convert PNG ke JPG?</h2>
  <ul>
    <li>Ukuran file lebih ringan</li>
    <li>Lebih cepat di-load di website</li>
    <li>Kompatibel di semua perangkat</li>
    <li>Cocok untuk upload ke media sosial</li>
  </ul>

</section>

<!-- COLLAPSE -->
<section class="tool-more">

  <details open>
    <summary>Cara Menggunakan</summary>
    <p>
      Upload file PNG, klik convert, lalu download hasil JPG.
    </p>
  </details>

  <details>
    <summary>Fitur Tools Ini</summary>
    <ul>
      <li>Convert PNG ke JPG</li>
      <li>Tanpa upload ke server (aman)</li>
      <li>Proses cepat di browser</li>
      <li>Gratis tanpa login</li>
    </ul>
  </details>

  <details>
    <summary>Kapan Digunakan?</summary>
    <ul>
      <li>Optimasi gambar website</li>
      <li>Upload ke platform tertentu</li>
      <li>Konversi format gambar</li>
    </ul>
  </details>

</section>

<script is:inline>
window.convert = function(){
  const fileInput = document.getElementById("file");
  const file = fileInput.files[0];

  if(!file){
    alert("Upload file PNG dulu!");
    return;
  }

  const img = new Image();
  const reader = new FileReader();

  reader.onload = function(e){
    img.src = e.target.result;
  };

  img.onload = function(){
    const canvas = document.getElementById("canvas");
    const ctx = canvas.getContext("2d");

    canvas.width = img.width;
    canvas.height = img.height;

    // background putih (biar transparan PNG tidak jadi hitam)
    ctx.fillStyle = "#ffffff";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.drawImage(img, 0, 0);

    const jpg = canvas.toDataURL("image/jpeg", 0.9);

    const downloadBtn = document.getElementById("downloadBtn");
    downloadBtn.href = jpg;

    document.getElementById("downloadWrap").style.display = "block";
  };

  reader.readAsDataURL(file);
};
</script>

</MainLayout>
