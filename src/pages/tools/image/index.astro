---
import MainLayout from "../../../layouts/MainLayout.astro";

// ambil semua tools dalam folder image
const modules = Object.entries(
  import.meta.glob('./**/*.astro', { eager: true })
);

// filter hanya category IMAGE
const tools = modules
  .map(([file, mod]) => {
    if (!mod.meta) return null;

    const url = file
      .replace('/src/pages', '')
      .replace('.astro', '');

    return { url, ...mod.meta };
  })
  .filter(Boolean)
  .filter(t => t.category?.toLowerCase().trim() === "image");

// featured
const featured = tools.filter(t => t.featured);

// stats
const total = tools.length;

// SEO JSON-LD
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Image Tools Online Gratis",
  itemListElement: tools.map((tool, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: tool.title,
    url: `https://aimrferdy.net${tool.url}`
  }))
};
---

<MainLayout 
  title="Image Tools Online Gratis Lengkap | AI Mr Ferdy"
  description="Kumpulan tools gambar online gratis: resize, compress, convert, dan edit gambar langsung di browser tanpa install."
pageCSS={["tools"]}>

<div class="tools-container">

  <!-- HERO -->
  <section class="tools-hero">
    <h1>Image Tools Online Gratis</h1>
    <p>Edit, convert, dan optimasi gambar langsung di browser tanpa install.</p>
  </section>

  <!-- STATS -->
  <section class="tools-stats">
    <div><strong>{total}</strong><span>Tools</span></div>
    <div><strong>100%</strong><span>Gratis</span></div>
    <div><strong>Fast</strong><span>No Login</span></div>
  </section>

  <!-- SEARCH -->
  <section class="tools-search">
    <input 
      id="searchTools"
      type="text"
      placeholder="Cari image tools..."
      onInput="filterTools()"
    />
  </section>

  <!-- FEATURED -->
  {featured.length > 0 && (
    <section>
      <h2 class="section-title">🔥 Popular Image Tools</h2>

      <div class="tools-grid">
        {featured.map(tool => (
          <a href={tool.url} class="tool-card popular">
            <div class="badge">HOT</div>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- LIST -->
  <section>
    <h2 class="section-title">📂 Semua Image Tools</h2>

    <div class="tools-grid">
      {tools.map(tool => (
        <a href={tool.url} class="tool-card">
          <h3>{tool.title}</h3>
          <p>{tool.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- EMPTY -->
  <div id="emptyState" class="tools-empty" style="display:none;">
    Tidak ada tools ditemukan
  </div>

  <!-- SEO CONTENT -->
  <section class="seo-content">
    <h2>Apa Itu Image Tools?</h2>
    <p>
      Image tools adalah alat online yang digunakan untuk mengedit dan memproses gambar,
      seperti resize, compress, convert format, hingga optimasi ukuran file.
      Tools ini sangat berguna untuk blogger, designer, dan developer.
    </p>

    <h2>Fitur Image Tools yang Umum Digunakan</h2>
    <ul>
      <li>Resize gambar (ubah ukuran)</li>
      <li>Compress gambar (kecilkan ukuran file)</li>
      <li>Convert format (JPG, PNG, WebP)</li>
      <li>Crop dan edit sederhana</li>
    </ul>

    <h2>Kenapa Pakai Image Tools Online?</h2>
    <p>
      Dengan image tools online dari AI Mr Ferdy, kamu bisa mengedit gambar langsung di browser
      tanpa install software tambahan. Semua tools gratis dan cepat digunakan.
    </p>

    <p>
      👉 <a href="/tools">Lihat semua tools lainnya</a>
    </p>
  </section>

</div>

<!-- SCRIPT -->
<script>
window.filterTools = function () {
  const q = document.getElementById("searchTools").value.toLowerCase();
  const cards = document.querySelectorAll(".tool-card");
  let visible = 0;

  cards.forEach(card => {
    const match = card.innerText.toLowerCase().includes(q);
    card.style.display = match ? "block" : "none";
    if (match) visible++;
  });

  document.getElementById("emptyState").style.display = visible ? "none" : "block";
};
</script>

<!-- SEO -->
<script type="application/ld+json">
{JSON.stringify(jsonLd)}
</script>

</MainLayout>
