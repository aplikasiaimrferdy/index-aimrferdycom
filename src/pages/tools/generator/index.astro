---
import MainLayout from "../../../layouts/MainLayout.astro";

// ambil semua tools
const modules = Object.entries(
  import.meta.glob('./**/*.astro', { eager: true })
);

// filter hanya category GENERATOR
const tools = modules
  .map(([file, mod]) => {
    if (!mod.meta) return null;

    const url = file
      .replace('/src/pages', '')
      .replace('.astro', '');

    return { url, ...mod.meta };
  })
  .filter(Boolean)
  .filter(t => t.category?.toLowerCase().trim() === "generator");

// featured
const featured = tools.filter(t => t.featured);

// stats
const total = tools.length;

// SEO JSON-LD
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Generator Tools Online Gratis",
  itemListElement: tools.map((tool, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: tool.title,
    url: `https://aimrferdy.net${tool.url}`
  }))
};
---

<MainLayout 
  title="Generator Tools Online Gratis Lengkap | AI Mr Ferdy"
  description="Kumpulan generator online gratis: password, teks, nama, ide konten, dan lainnya tanpa install."
pageCSS={["tools"]}>

<div class="tools-container">

  <!-- HERO -->
  <section class="tools-hero">
    <h1>Generator Tools Online Gratis</h1>
    <p>Buat teks, password, ide, dan data secara otomatis dalam satu klik.</p>
  </section>

  <!-- STATS -->
  <section class="tools-stats">
    <div><strong>{total}</strong><span>Tools</span></div>
    <div><strong>100%</strong><span>Gratis</span></div>
    <div><strong>Fast</strong><span>No Login</span></div>
  </section>

  <!-- SEARCH -->
  <section class="tools-search">
    <input 
      id="searchTools"
      type="text"
      placeholder="Cari generator..."
      onInput="filterTools()"
    />
  </section>

  <!-- FEATURED -->
  {featured.length > 0 && (
    <section>
      <h2 class="section-title">🔥 Popular Generators</h2>

      <div class="tools-grid">
        {featured.map(tool => (
          <a href={tool.url} class="tool-card popular">
            <div class="badge">HOT</div>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- LIST -->
  <section>
    <h2 class="section-title">📂 Semua Generator</h2>

    <div class="tools-grid">
      {tools.map(tool => (
        <a href={tool.url} class="tool-card">
          <h3>{tool.title}</h3>
          <p>{tool.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- EMPTY -->
  <div id="emptyState" class="tools-empty" style="display:none;">
    Tidak ada generator ditemukan
  </div>

  <!-- SEO CONTENT -->
  <section class="seo-content">
    <h2>Apa Itu Generator Tools?</h2>
    <p>
      Generator tools adalah alat online yang digunakan untuk membuat sesuatu secara otomatis,
      seperti password, teks, ide konten, hingga data acak. Tools ini sangat membantu untuk
      mempercepat pekerjaan tanpa perlu membuat dari nol.
    </p>

    <h2>Jenis Generator yang Paling Populer</h2>
    <ul>
      <li>Password Generator</li>
      <li>Username Generator</li>
      <li>Text & Lorem Ipsum Generator</li>
      <li>AI Content Generator</li>
    </ul>

    <h2>Kenapa Menggunakan Generator Online?</h2>
    <p>
      Dengan generator online dari AI Mr Ferdy, kamu bisa membuat berbagai kebutuhan
      secara instan tanpa install aplikasi. Semua tools dapat digunakan gratis
      langsung dari browser.
    </p>

    <p>
      👉 <a href="/tools">Lihat semua tools lainnya</a>
    </p>
  </section>

</div>

<!-- SCRIPT -->
<script>
window.filterTools = function () {
  const q = document.getElementById("searchTools").value.toLowerCase();
  const cards = document.querySelectorAll(".tool-card");
  let visible = 0;

  cards.forEach(card => {
    const match = card.innerText.toLowerCase().includes(q);
    card.style.display = match ? "block" : "none";
    if (match) visible++;
  });

  document.getElementById("emptyState").style.display = visible ? "none" : "block";
};
</script>

<!-- SEO -->
<script type="application/ld+json">
{JSON.stringify(jsonLd)}
</script>

</MainLayout>
