---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "🔥 AI Hashtag Generator",
  description: "Generate hashtag viral untuk TikTok & Instagram.",
  category: "Generator",
  featured: true
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tools"]}>

<div class="tool-box">

  <h1>🔥 AI Hashtag Generator</h1>
  <p class="desc">Generate hashtag viral untuk TikTok & Instagram 🚀</p>

  <div class="form-group">
    <label>Topik</label>
    <input id="topic" class="tool-input" placeholder="Contoh: jualan online, skincare, affiliate..." />
  </div>

  <div class="form-group">
    <label>Platform</label>
    <select id="platform" class="tool-input">
      <option value="tiktok">TikTok</option>
      <option value="instagram">Instagram</option>
    </select>
  </div>

  <div class="btn-group">
    <button class="btn btn-primary" onclick="generateHashtag()">🚀 Generate</button>
    <button class="btn btn-secondary" onclick="copyHashtag()">📋 Copy</button>
  </div>

  <div class="form-group">
    <label>Hasil Hashtag</label>
    <textarea id="result" class="tool-textarea" placeholder="Hashtag akan muncul di sini..."></textarea>
  </div>

</div>

<!-- SEO + COLLAPSE -->
<section class="tool-more">

  <details open>
    <summary>📌 Cara Menggunakan Hashtag Generator</summary>
    <p>
      Masukkan topik konten kamu, pilih platform, lalu klik generate.
      Gunakan hashtag yang dihasilkan untuk meningkatkan jangkauan dan peluang viral.
    </p>
  </details>

  <details>
    <summary>🔥 Fitur Tools Ini</summary>
    <ul>
      <li>Generate hashtag otomatis</li>
      <li>Khusus TikTok & Instagram</li>
      <li>Gratis tanpa login</li>
      <li>Siap copy & paste</li>
    </ul>
  </details>

  <details>
    <summary>🚀 Tips Hashtag Viral</summary>
    <ul>
      <li>Gunakan kombinasi hashtag besar & kecil</li>
      <li>Jangan terlalu banyak (5–10 cukup)</li>
      <li>Sesuaikan dengan niche</li>
      <li>Gunakan hashtag trending</li>
    </ul>
  </details>

</section>

<script is:inline>
window.generateHashtag = function(){
  const topic = document.getElementById("topic").value.trim();
  const platform = document.getElementById("platform").value;
  const result = document.getElementById("result");

  if(!topic){
    alert("Isi topik dulu!");
    return;
  }

  const base = topic.toLowerCase().replace(/\s+/g, "");

  let hashtags = [];

  if(platform === "tiktok"){
    hashtags = [
      `#${base}`,
      `#${base}viral`,
      `#fyp`,
      `#foryou`,
      `#foryoupage`,
      `#viral`,
      `#trending`,
      `#kontenviral`,
      `#belajar${base}`,
      `#tips${base}`
    ];
  } else {
    hashtags = [
      `#${base}`,
      `#${base}indonesia`,
      `#explore`,
      `#viral`,
      `#instagood`,
      `#contentcreator`,
      `#bisnisonline`,
      `#tips${base}`,
      `#belajar${base}`,
      `#reels`
    ];
  }

  result.value = hashtags.join(" ");
}

window.copyHashtag = function(){
  const text = document.getElementById("result").value;

  if(!text){
    alert("Belum ada hasil!");
    return;
  }

  navigator.clipboard.writeText(text);
}
</script>

</MainLayout>
