<!-- QR LIB (FIX ASTRO) -->
<script client:load src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>

<script client:load>

window.currentTab = "text";

// TAB
window.switchTab = function(tab, el){
  window.currentTab = tab;

  document.querySelectorAll(".tab").forEach(t => t.classList.remove("active"));
  document.getElementById("tab-" + tab).classList.add("active");

  document.querySelectorAll(".tabs button").forEach(b => b.classList.remove("active"));
  el.classList.add("active");
}

// ADVANCED
window.toggleAdvanced = function(){
  document.getElementById("advancedBox").classList.toggle("active");
}

// GENERATE
window.generateQR = function(){

  if(typeof QRCode === "undefined"){
    alert("QR masih loading...");
    return;
  }

  let text = "";

  if(window.currentTab === "text"){
    text = document.getElementById("qrInput").value.trim();
  }

  if(window.currentTab === "wa"){
    const n = document.getElementById("waNumber").value.trim();
    const m = document.getElementById("waMessage").value.trim();

    if(!n){
      alert("Nomor WA wajib");
      return;
    }

    text = m
      ? `https://wa.me/${n}?text=${encodeURIComponent(m)}`
      : `https://wa.me/${n}`;
  }

  if(window.currentTab === "wifi"){
    const s = document.getElementById("wifiSSID").value.trim();
    const p = document.getElementById("wifiPass").value.trim();

    if(!s){
      alert("Nama WiFi wajib");
      return;
    }

    text = p
      ? `WIFI:T:WPA;S:${s};P:${p};;`
      : `WIFI:T:nopass;S:${s};;`;
  }

  if(!text){
    alert("Input kosong");
    return;
  }

  const canvas = document.getElementById("qrCanvas");

  QRCode.toCanvas(canvas, text, {
    width: parseInt(document.getElementById("qrSize").value) || 300,
    margin: 2,
    color: {
      dark: document.getElementById("qrColor").value,
      light: document.getElementById("bgColor").value
    }
  }, function(err){

    if(err){
      console.error(err);
      alert("Gagal generate QR");
      return;
    }

    addLogo();
    document.getElementById("downloadBox").classList.add("active");
  });
}

// LOGO
function addLogo(){
  const file = document.getElementById("logoInput").files[0];
  if(!file) return;

  const canvas = document.getElementById("qrCanvas");
  const ctx = canvas.getContext("2d");

  const img = new Image();
  img.onload = function(){
    const size = canvas.width * 0.2;
    ctx.drawImage(img, (canvas.width-size)/2, (canvas.height-size)/2, size, size);
  }

  img.src = URL.createObjectURL(file);
}

// DOWNLOAD
window.downloadPNG = function(){
  const canvas = document.getElementById("qrCanvas");
  const a = document.createElement("a");
  a.href = canvas.toDataURL();
  a.download = "qr.png";
  a.click();
}

window.downloadSVG = function(){
  const text = document.getElementById("qrInput").value || "QR";

  QRCode.toString(text, { type: 'svg' }, function (err, svg) {
    const blob = new Blob([svg], {type: "image/svg+xml"});
    const url = URL.createObjectURL(blob);

    const a = document.createElement("a");
    a.href = url;
    a.download = "qr.svg";
    a.click();
  });
}

</script>

