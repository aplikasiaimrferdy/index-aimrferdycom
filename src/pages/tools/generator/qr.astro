---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "QR Code Generator Online",
  description: "Buat QR Code custom dengan warna, logo, WiFi & WhatsApp.",
  category: "Generator",
  featured: true
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tool"]}>



  <div class="page-content">
<div class="qr-app">

<!-- LEFT -->
<div class="qr-panel">

<div class="qr-title">Buat QR Code</div>

<div class="tabs">
  <button onclick="switchTab('text', this)" class="active">Text</button>
  <button onclick="switchTab('wa', this)">WhatsApp</button>
  <button onclick="switchTab('wifi', this)">WiFi</button>
</div>

<div id="tab-text" class="tab active">
  <input id="qrInput" class="qr-input" placeholder="Masukkan teks / URL">
</div>

<div id="tab-wa" class="tab">
  <input id="waNumber" class="qr-input" placeholder="628xxxx">
  <input id="waMessage" class="qr-input" placeholder="Pesan (opsional)">
</div>

<div id="tab-wifi" class="tab">
  <input id="wifiSSID" class="qr-input" placeholder="Nama WiFi">
  <input id="wifiPass" class="qr-input" placeholder="Password">
</div>

<button class="btn-primary" onclick="generateQR()">Generate QR</button>

<div class="qr-advanced-toggle" onclick="toggleAdvanced()">
⚙️ Pengaturan Lanjutan
</div>

<div id="advancedBox" class="qr-advanced">

<label>Warna QR</label>
<input type="color" id="qrColor" value="#000000">

<label>Background</label>
<input type="color" id="bgColor" value="#ffffff">

<label>Ukuran</label>
<select id="qrSize">
  <option value="200">Small</option>
  <option value="400">Medium</option>
  <option value="800">HD</option>
</select>

<label>Logo</label>
<input type="file" id="logoInput">

</div>

</div>

<!-- RIGHT -->
<div class="qr-panel">

<div class="qr-title">Preview</div>

<div class="qr-preview">
  <canvas id="qrCanvas"></canvas>
</div>

<div id="downloadBox" class="qr-download">
  <button onclick="downloadPNG()">PNG</button>
  <button onclick="downloadSVG()">SVG</button>
</div>

</div>

</div>
</div>


<div>

  <!-- HERO -->
  <section class="tool-hero">
    <h1>QR Code Generator Online Gratis</h1>
    <p>
      Buat QR Code untuk URL, WiFi, WhatsApp, dan teks dengan cepat tanpa install.
      Gratis, cepat, dan langsung bisa digunakan di browser.
    </p>
  </section>

  <!-- APP -->
  <section class="tool-box">
    <!-- TARUH UI QR KAMU DI SINI -->
    <p><strong>⬇️ Gunakan tool di atas untuk generate QR Code</strong></p>
  </section>

  <!-- SEO CONTENT (VISIBLE) -->
  <section class="tool-seo">
    <h2>Apa Itu QR Code Generator?</h2>
    <p>
      QR Code Generator adalah alat online yang digunakan untuk membuat kode QR
      yang bisa dipindai menggunakan kamera smartphone. QR Code dapat berisi
      berbagai informasi seperti link website, nomor WhatsApp, atau koneksi WiFi.
    </p>

    <h2>Kenapa Menggunakan QR Code?</h2>
    <ul>
      <li>Praktis untuk berbagi link</li>
      <li>Cocok untuk bisnis & promosi</li>
      <li>Bisa digunakan offline</li>
      <li>Mudah di-scan dengan smartphone</li>
    </ul>
  </section>

  <!-- COLLAPSE CONTENT -->
  <section class="tool-more">

    <details>
      <summary>Cara Membuat QR Code</summary>
      <p>
        Masukkan teks, URL, atau data yang ingin kamu ubah menjadi QR Code.
        Pilih jenis QR seperti WhatsApp atau WiFi, lalu klik tombol generate.
        Setelah itu, kamu bisa download hasilnya dalam format PNG atau SVG.
      </p>
    </details>

    <details>
      <summary>Fitur QR Code Generator Ini</summary>
      <ul>
        <li>Custom warna QR</li>
        <li>Tambahkan logo di tengah</li>
        <li>Support QR WhatsApp & WiFi</li>
        <li>Download PNG & SVG</li>
      </ul>
    </details>

    <details>
      <summary>Tips Agar QR Code Mudah Di-scan</summary>
      <ul>
        <li>Gunakan kontras warna tinggi</li>
        <li>Jangan terlalu kecil</li>
        <li>Hindari terlalu banyak logo</li>
      </ul>
    </details>

  </section>


</div>

