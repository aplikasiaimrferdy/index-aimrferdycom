---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "👤 Username Generator Online",
  description: "Buat username keren untuk Instagram, TikTok, dan game secara otomatis. Gratis dan mudah digunakan.",
  category: "Generator",
  featured: true
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tools"]}>

<!-- HERO -->
<section class="tool-hero">
  <h1>👤 Username Generator Online Gratis</h1>
  <p>
    Buat username keren untuk Instagram, TikTok, game, dan brand dengan cepat.
    Gratis, unik, dan langsung bisa digunakan.
  </p>
</section>

<!-- APP -->
<section class="tool-box">

  <div class="form-group">
    <label>Nama / Keyword</label>
    <input id="keyword" class="tool-input" placeholder="Contoh: ferdy, gaming, bisnis..." />
  </div>

  <div class="form-group">
    <label>Gaya Username</label>
    <select id="style" class="tool-input">
      <option value="cool">😎 Cool</option>
      <option value="aesthetic">✨ Aesthetic</option>
      <option value="gaming">🎮 Gaming</option>
      <option value="brand">💼 Brand</option>
    </select>
  </div>

  <div class="btn-group">
    <button class="btn btn-primary" onclick="generateUsername()">🚀 Generate</button>
  </div>

  <div class="form-group">
    <label>Hasil Username</label>
    <textarea id="result" class="tool-textarea" placeholder="Username akan muncul di sini..."></textarea>
  </div>

  <!-- COPY -->
  <div id="copyWrap" style="display:none; margin-top:10px;">
    <button class="btn btn-secondary" onclick="copyUsername()">📋 Copy Username</button>
  </div>

  <p style="margin-top:15px;">
    <strong>⬇️ Gunakan tool di atas untuk generate username</strong>
  </p>

</section>

<!-- SEO CONTENT -->
<section class="tool-seo">

  <h2>Apa Itu Username Generator?</h2>
  <p>
    Username Generator adalah alat online untuk membuat nama pengguna unik secara otomatis.
    Tools ini membantu kamu menemukan username yang belum dipakai dan cocok untuk
    Instagram, TikTok, game, atau branding online.
  </p>

  <h2>Kenapa Username Penting?</h2>
  <ul>
    <li>Membantu branding personal atau bisnis</li>
    <li>Lebih mudah diingat oleh orang lain</li>
    <li>Meningkatkan profesionalitas akun</li>
    <li>Membedakan kamu dari kompetitor</li>
  </ul>

</section>

<!-- COLLAPSE -->
<section class="tool-more">

  <details open>
    <summary>Cara Membuat Username</summary>
    <p>
      Masukkan nama atau keyword, pilih gaya username, lalu klik generate.
      Kamu akan mendapatkan beberapa ide username yang bisa langsung digunakan.
    </p>
  </details>

  <details>
    <summary>Fitur Username Generator Ini</summary>
    <ul>
      <li>Generate username otomatis</li>
      <li>Berbagai gaya (cool, aesthetic, gaming, brand)</li>
      <li>Cocok untuk semua platform</li>
      <li>Gratis tanpa login</li>
    </ul>
  </details>

  <details>
    <summary>Tips Memilih Username</summary>
    <ul>
      <li>Gunakan nama yang mudah diingat</li>
      <li>Hindari terlalu panjang</li>
      <li>Gunakan kombinasi kata & angka jika perlu</li>
      <li>Sesuaikan dengan niche atau brand</li>
    </ul>
  </details>

</section>

<script is:inline>
window.generateUsername = function(){
  const keyword = document.getElementById("keyword").value.trim().toLowerCase();
  const style = document.getElementById("style").value;
  const result = document.getElementById("result");

  if(!keyword){
    alert("Isi keyword dulu!");
    document.getElementById("copyWrap").style.display = "none";
    return;
  }

  let list = [];

  if(style === "cool"){
    list = [
      `${keyword}_official`,
      `real${keyword}`,
      `${keyword}.id`,
      `${keyword}_zone`,
      `its${keyword}`
    ];
  }

  if(style === "aesthetic"){
    list = [
      `${keyword}xoxo`,
      `luv${keyword}`,
      `${keyword}dream`,
      `${keyword}vibes`,
      `${keyword}sky`
    ];
  }

  if(style === "gaming"){
    list = [
      `${keyword}gaming`,
      `${keyword}pro`,
      `${keyword}killer`,
      `${keyword}x`,
      `${keyword}legend`
    ];
  }

  if(style === "brand"){
    list = [
      `${keyword}official`,
      `${keyword}store`,
      `${keyword}co`,
      `${keyword}brand`,
      `${keyword}id`
    ];
  }

  result.value = list.join("\n");

  document.getElementById("copyWrap").style.display = "block";
};

window.copyUsername = function(){
  const text = document.getElementById("result").value;
  const btn = document.querySelector("#copyWrap button");

  if(!text){
    alert("Belum ada hasil!");
    return;
  }

  navigator.clipboard.writeText(text);

  btn.innerText = "✅ Copied!";
  setTimeout(() => {
    btn.innerText = "📋 Copy Username";
  }, 1500);
};
</script>

</MainLayout>
