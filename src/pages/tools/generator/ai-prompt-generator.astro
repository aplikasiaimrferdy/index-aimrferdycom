---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "AI Prompt Generator Gratis (ChatGPT, Gemini, Midjourney, Veo)",
  description: "Buat prompt AI otomatis untuk ChatGPT, Gemini, Midjourney, dan video AI seperti Veo. Gratis & tanpa login.",
  category: "Generator",
  featured: true
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tools"]}>

<div class="container">

<h1>AI Prompt Generator</h1>
<p>Buat prompt AI otomatis untuk berbagai platform seperti ChatGPT, Gemini, Midjourney, dan Veo.</p>

<div class="tool-box">

<select id="platform" class="input">
  <option value="chatgpt">ChatGPT</option>
  <option value="gemini">Gemini</option>
  <option value="midjourney">Midjourney (Image)</option>
  <option value="veo">Veo (Video)</option>
</select>

<input id="topic" class="input" placeholder="Topik (contoh: bisnis online)" />

<select id="style" class="input">
  <option value="profesional">Profesional</option>
  <option value="santai">Santai</option>
  <option value="viral">Viral</option>
  <option value="storytelling">Storytelling</option>
</select>

<select id="language" class="input">
  <option value="id">Bahasa Indonesia</option>
  <option value="en">English</option>
</select>

<button class="btn-primary" onclick="generatePrompt()">Generate Prompt</button>

<textarea id="result" class="output" placeholder="Hasil prompt muncul di sini..."></textarea>

<button class="btn-secondary" onclick="copyPrompt()">Copy</button>

</div>

<!-- SEO CONTENT -->
<section class="tool-more">

<details>
<summary>Apa itu AI Prompt Generator?</summary>
<p>
AI Prompt Generator adalah tools untuk membuat instruksi otomatis yang bisa digunakan di berbagai AI seperti ChatGPT, Gemini, dan Midjourney.
</p>
</details>

<details>
<summary>Cara Menggunakan</summary>
<p>
Pilih platform AI, masukkan topik, pilih gaya, lalu klik generate. Salin prompt dan gunakan di AI favorit kamu.
</p>
</details>

</section>

</div>

<script>
window.generatePrompt = function(){
  const platform = document.getElementById("platform").value;
  const topic = document.getElementById("topic").value;
  const style = document.getElementById("style").value;
  const lang = document.getElementById("language").value;

  if(!topic){
    alert("Masukkan topik dulu");
    return;
  }

  let prompt = "";

  // INDONESIA
  if(lang === "id"){
    if(platform === "chatgpt"){
      prompt = `Buat konten tentang ${topic} dengan gaya ${style}, jelas, menarik, dan mudah dipahami.`;
    }

    if(platform === "gemini"){
      prompt = `Jelaskan ${topic} secara detail dengan gaya ${style} dan berikan contoh nyata.`;
    }

    if(platform === "midjourney"){
      prompt = `Gambar ${topic}, gaya ${style}, ultra realistic, 4K, detailed, cinematic lighting`;
    }

    if(platform === "veo"){
      prompt = `Video cinematic tentang ${topic}, gaya ${style}, 4K, slow motion, dramatic lighting`;
    }
  }

  // ENGLISH
  if(lang === "en"){
    if(platform === "chatgpt"){
      prompt = `Create content about ${topic} in a ${style} style, clear and engaging.`;
    }

    if(platform === "gemini"){
      prompt = `Explain ${topic} in detail with a ${style} tone and real examples.`;
    }

    if(platform === "midjourney"){
      prompt = `A detailed image of ${topic}, ${style}, ultra realistic, 4K, cinematic lighting`;
    }

    if(platform === "veo"){
      prompt = `A cinematic video about ${topic}, ${style}, 4K, dramatic lighting, slow motion`;
    }
  }

  document.getElementById("result").value = prompt;
}

// COPY
window.copyPrompt = function(){
  const text = document.getElementById("result");
  text.select();
  document.execCommand("copy");
  alert("Prompt disalin!");
}
</script>

<style>
.tool-box {
  margin-top:20px;
  padding:20px;
  background:var(--card);
  border-radius:12px;
  border:1px solid var(--border);
}

.input, .output {
  width:100%;
  padding:12px;
  margin-bottom:10px;
  border-radius:8px;
  border:1px solid var(--border);
  background:transparent;
  color:var(--text);
}

.output {
  min-height:120px;
}

.btn-primary {
  width:100%;
  padding:14px;
  border-radius:10px;
  border:none;
  background:linear-gradient(135deg,#0ea5e9,#2563eb);
  color:white;
  font-weight:600;
  cursor:pointer;
  margin-bottom:10px;
}

.btn-secondary {
  width:100%;
  padding:12px;
  border-radius:10px;
  border:1px solid var(--border);
  background:transparent;
  cursor:pointer;
}
</style>

</MainLayout>
