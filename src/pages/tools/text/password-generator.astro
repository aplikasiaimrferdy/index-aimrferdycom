---
import MainLayout from "../../../layouts/MainLayout.astro";

export const meta = {
  title: "Password Generator",
  description: "Buat password kuat dan aman secara otomatis dengan berbagai opsi.",
  category: "Text",
  featured: true
};
---

<MainLayout title={`${meta.title} | AI Mr Ferdy`} description={meta.description} pageCSS={["tools"]}>


<div class="container tools-page">

<h1>🔑 Password Generator</h1>

<p class="tools-sub">
Buat password kuat dan aman untuk akun, aplikasi, atau database.
</p>

<!-- INPUT -->
<div class="tool-box">

<label>Panjang Password</label>
<input type="number" id="length" class="tool-input" value="12" min="4" max="50">

<div class="btn-group">

<label><input type="checkbox" id="upper" checked> Huruf Besar (A-Z)</label>
<label><input type="checkbox" id="lower" checked> Huruf Kecil (a-z)</label>
<label><input type="checkbox" id="number" checked> Angka (0-9)</label>
<label><input type="checkbox" id="symbol"> Simbol (!@#$)</label>

</div>

<button class="btn-primary" onclick="generate()">
Generate Password
</button>

</div>

<!-- RESULT -->
<div id="result" class="tool-result">
Password akan muncul di sini...
</div>

<div class="btn-group">
<button class="btn-secondary" onclick="copyText()">Copy</button>
</div>

</div>



<script>
function generatePassword(length, useUpper, useLower, useNumber, useSymbol){
  const upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  const lower = "abcdefghijklmnopqrstuvwxyz";
  const number = "0123456789";
  const symbol = "!@#$%^&*()_+{}[]<>?/";

  let chars = "";
  if(useUpper) chars += upper;
  if(useLower) chars += lower;
  if(useNumber) chars += number;
  if(useSymbol) chars += symbol;

  if(chars === ""){
    return "Pilih minimal 1 opsi karakter!";
  }

  let password = "";
  for(let i = 0; i < length; i++){
    const randomIndex = Math.floor(Math.random() * chars.length);
    password += chars[randomIndex];
  }

  return password;
}

window.generate = function(){
  const length = parseInt(document.getElementById("length").value);
  const upper = document.getElementById("upper").checked;
  const lower = document.getElementById("lower").checked;
  const number = document.getElementById("number").checked;
  const symbol = document.getElementById("symbol").checked;

  const result = generatePassword(length, upper, lower, number, symbol);
  document.getElementById("result").innerText = result;
}

window.copyText = function(){
  const text = document.getElementById("result").innerText;
  navigator.clipboard.writeText(text);
  alert("Copied!");
}
</script>

</MainLayout>
