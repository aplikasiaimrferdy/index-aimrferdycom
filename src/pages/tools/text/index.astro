---
import MainLayout from "../../../layouts/MainLayout.astro";

// ambil semua tools
const modules = Object.entries(
  import.meta.glob('./**/*.astro', { eager: true })
);

// filter hanya category TEXT
const tools = modules
  .map(([file, mod]) => {
    if (!mod.meta) return null;

    const url = file
      .replace('/src/pages', '')
      .replace('.astro', '');

    return { url, ...mod.meta };
  })
  .filter(Boolean)
  .filter(t => t.category === "Text");

// featured
const featured = tools.filter(t => t.featured);

// stats
const total = tools.length;

// SEO JSON-LD
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Text Tools Online Gratis",
  itemListElement: tools.map((tool, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: tool.title,
    url: `https://aimrferdy.net${tool.url}`
  }))
};
---

<MainLayout 
  title="Text Tools Online Gratis Lengkap | AI Mr Ferdy"
  description="Gunakan berbagai tools teks gratis seperti JSON formatter, encoder, dan generator langsung di browser tanpa install."
pageCSS={["tools"]}>

<div class="tools-container">

  <!-- HERO -->
  <section class="tools-hero">
    <h1>Text Tools Online Gratis</h1>
    <p>Formatter, encoder, dan generator teks gratis tanpa install.</p>
  </section>

  <!-- STATS -->
  <section class="tools-stats">
    <div><strong>{total}</strong><span>Tools</span></div>
    <div><strong>100%</strong><span>Gratis</span></div>
    <div><strong>Fast</strong><span>No Login</span></div>
  </section>

  <!-- SEARCH -->
  <section class="tools-search">
    <input 
      id="searchTools"
      type="text"
      placeholder="Cari text tools..."
      onInput="filterTools()"
    />
  </section>

  <!-- FEATURED -->
  {featured.length > 0 && (
    <section>
      <h2 class="section-title">🔥 Popular Text Tools</h2>

      <div class="tools-grid">
        {featured.map(tool => (
          <a href={tool.url} class="tool-card popular">
            <div class="badge">HOT</div>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- LIST -->
  <section>
    <h2 class="section-title">📂 Semua Text Tools</h2>

    <div class="tools-grid">
      {tools.map(tool => (
        <a href={tool.url} class="tool-card">
          <h3>{tool.title}</h3>
          <p>{tool.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- EMPTY -->
  <div id="emptyState" class="tools-empty" style="display:none;">
    Tidak ada tools ditemukan
  </div>

  <!-- SEO CONTENT -->
  <section class="seo-content">
    <h2>Apa Itu Text Tools?</h2>
    <p>
      Text tools adalah kumpulan alat online yang digunakan untuk memproses teks
      seperti formatting, encoding, hingga generate konten secara otomatis.
      Tools ini sangat membantu untuk developer, blogger, dan pengguna umum.
    </p>

    <h2>Fungsi Text Tools Online</h2>
    <ul>
      <li>Merapikan JSON dan kode</li>
      <li>Encode & decode teks</li>
      <li>Membuat password aman</li>
      <li>Mengubah format teks dengan cepat</li>
    </ul>

    <h2>Kenapa Menggunakan AI Mr Ferdy?</h2>
    <p>
      Semua text tools di AI Mr Ferdy bisa digunakan secara gratis tanpa install.
      Cukup buka halaman tools dan langsung pakai di browser dengan cepat dan mudah.
    </p>
  </section>

</div>

<!-- SCRIPT -->
<script>
window.filterTools = function () {
  const q = document.getElementById("searchTools").value.toLowerCase();
  const cards = document.querySelectorAll(".tool-card");
  let visible = 0;

  cards.forEach(card => {
    const match = card.innerText.toLowerCase().includes(q);
    card.style.display = match ? "block" : "none";
    if (match) visible++;
  });

  document.getElementById("emptyState").style.display = visible ? "none" : "block";
};
</script>

<!-- SEO -->
<script type="application/ld+json">
{JSON.stringify(jsonLd)}
</script>

</MainLayout>
