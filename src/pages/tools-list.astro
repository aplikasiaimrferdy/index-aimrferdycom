---
import MainLayout from "../layouts/MainLayout.astro";

const modules = Object.entries(
  import.meta.glob("./tools/**/**/*.astro", {
    eager: true
  })
);

const tools = modules
  .map(([file, mod]) => {
    const match = file.match(
      /^\.\/tools\/([^/]+)\/(.+)\.astro$/
    );

    if (!match) {
      return null;
    }

    const category = match[1];
    const slug = match[2];

    if (
      category === "[category]" ||
      slug === "index"
    ) {
      return null;
    }

    if (!mod.meta?.title) {
      return null;
    }

    return {
      title: mod.meta.title,
      category,
      slug
    };
  })
  .filter(Boolean)
  .sort((a, b) =>
    a.title.localeCompare(b.title, "id")
  );

/*
 * GROUP BY CATEGORY
 */

const categories = Object.entries(
  Object.groupBy(tools, (tool) => tool.category)
).sort(([a], [b]) =>
  a.localeCompare(b, "id")
);

const totalTools = tools.length;
---

<MainLayout
  title="Tools List"
  description="Daftar semua tools berdasarkan kategori."
>

  <main class="tools-list">

    <h1>Daftar Semua Tools</h1>

    <p class="count">
      {totalTools} tools
    </p>

    {categories.map(([category, categoryTools]) => (

      <section class="category">

        <h2>
          {category
            .replace(/[-_]/g, " ")
            .replace(/\b\w/g, (char) =>
              char.toUpperCase()
            )}
        </h2>

        <div class="titles">

          {categoryTools.map((tool) => (
            <div class="tool-title">
              {tool.title}
            </div>
          ))}

        </div>

      </section>

    ))}

  </main>

</MainLayout>

<style>
  .tools-list {
    width: min(800px, calc(100% - 32px));
    margin: 0 auto;
    padding: 80px 0;
  }

  h1 {
    margin: 0 0 8px;
  }

  .count {
    margin: 0 0 40px;
    color: var(--soft, #94a3b8);
  }

  .category {
    margin-bottom: 40px;
  }

  .category h2 {
    margin: 0 0 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid
      var(--border, rgba(255,255,255,.08));

    color: var(--primary, #3b82f6);
    font-size: 18px;
  }

  .tool-title {
    padding: 5px 0;
    color: var(--text, #f8fafc);
    font-size: 16px;
    line-height: 1.6;
  }
</style>
