---
import MainLayout from "../layouts/MainLayout.astro";

const modules = Object.entries(
  import.meta.glob("./tools/**/**/*.astro", {
    eager: true
  })
);

const tools = modules
  .map(([file, mod]) => {
    const match = file.match(
      /^\.\/tools\/([^/]+)\/(.+)\.astro$/
    );

    if (!match) return null;

    const category = match[1];
    const slug = match[2];

    if (
      category === "[category]" ||
      slug === "index"
    ) {
      return null;
    }

    if (!mod.meta?.title) {
      return null;
    }

    return {
      title: mod.meta.title,
      category,
      slug
    };
  })
  .filter(Boolean)
  .sort((a, b) =>
    a.title.localeCompare(b.title, "id")
  );

/* GROUP BY CATEGORY */

const grouped = tools.reduce((groups, tool) => {
  if (!groups[tool.category]) {
    groups[tool.category] = [];
  }

  groups[tool.category].push(tool);

  return groups;
}, {});

const categories = Object.entries(grouped).sort(
  ([a], [b]) => a.localeCompare(b, "id")
);

/* BUILD COPY TEXT */

const copyText = categories
  .map(([category, categoryTools]) => {
    const categoryTitle = category
      .replace(/[-_]/g, " ")
      .replace(/\b\w/g, (char) => char.toUpperCase());

    const titles = categoryTools
      .map((tool) => tool.title)
      .join("\n");

    return `${categoryTitle}\n\n${titles}`;
  })
  .join("\n\n\n");

const totalTools = tools.length;
---

<MainLayout
  title="Tools List"
  description="Daftar semua tools berdasarkan kategori."
>

  <main class="tools-list">

    <h1>Daftar Semua Tools</h1>

    <p>
      {totalTools} tools — klik kotak di bawah lalu
      <strong>Ctrl+A → Ctrl+C</strong>
    </p>

    <textarea
      readonly
      spellcheck="false"
      value={copyText}
      aria-label="Daftar semua judul tools"
    ></textarea>

  </main>

</MainLayout>

<style>
  .tools-list {
    width: min(900px, calc(100% - 32px));
    margin: 0 auto;
    padding: 80px 0;
  }

  h1 {
    margin-bottom: 8px;
  }

  p {
    margin-bottom: 20px;
    color: var(--soft, #94a3b8);
  }

  textarea {
    display: block;
    width: 100%;
    min-height: 800px;
    box-sizing: border-box;

    padding: 20px;

    border: 1px solid
      var(--border, rgba(255,255,255,.08));

    border-radius: 12px;

    background:
      var(--card, rgba(15,23,42,.72));

    color:
      var(--text, #f8fafc);

    font-family:
      monospace;

    font-size:
      15px;

    line-height:
      1.7;

    resize:
      vertical;
  }
</style>
