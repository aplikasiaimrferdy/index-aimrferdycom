---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../lib/site';

const pageTitle =
  'About Ai Mr Ferdy - AI, SEO & Digital Modern';

const pageDescription =
  'Tentang Ai Mr Ferdy, platform digital modern yang fokus pada AI, SEO, automation, teknologi, tools online dan pengembangan website modern ultra cepat.';
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`${SITE.url()}/about`}
>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">

        <div class="hero-left">

          <div class="hero-tag">
            ABOUT AI MR FERDY
          </div>

          <h1>
            Membangun Ecosystem Digital Modern
          </h1>

          <p>
            Ai Mr Ferdy adalah platform digital yang berfokus pada AI, SEO,
            automation, tools online, website modern dan teknologi internet
            masa kini dengan performa cepat, clean dan mobile first.
          </p>

          <div class="hero-btns">
            <a
              href="https://aimrferdy.com"
              class="btn btn-primary"
            >
              Official Website
            </a>

            <a
              href="https://news.aimrferdy.com"
              class="btn btn-secondary"
            >
              Latest Articles
            </a>
          </div>

        </div>

        <div class="hero-right">

          <div class="hero-card">
            <div class="hero-badge">
              TECHNOLOGY
            </div>

            <h3>
              AI & Automation
            </h3>

            <p>
              Fokus pada teknologi AI modern, automation system dan workflow digital.
            </p>
          </div>

          <div class="hero-card">
            <div class="hero-badge">
              PERFORMANCE
            </div>

            <h3>
              Fast & Clean
            </h3>

            <p>
              Website modern ultra ringan dengan design minimal dan SEO optimized.
            </p>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section">
    <div class="container">

      <h2 class="section-title">
        Siapa Ai Mr Ferdy?
      </h2>

      <p class="section-desc">
        Platform digital modern untuk teknologi, AI dan internet ecosystem.
      </p>

      <div class="features">

        <div class="feature-card">
          <h3>AI Technology</h3>

          <p>
            Mengembangkan dan membahas berbagai teknologi AI modern,
            automation dan smart digital system.
          </p>
        </div>

        <div class="feature-card">
          <h3>SEO & Website</h3>

          <p>
            Fokus pada website cepat, SEO modern, performa tinggi dan mobile first.
          </p>
        </div>

        <div class="feature-card">
          <h3>Digital Tools</h3>

          <p>
            Membangun tools online dan utility digital untuk kebutuhan modern.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- MISSION -->
  <section class="section">
    <div class="container">

      <h2 class="section-title">
        Mission
      </h2>

      <p class="section-desc">
        Membuat teknologi modern lebih cepat, ringan dan mudah diakses.
      </p>

      <div class="pricing">

        <div class="price-card">
          <h3>Modern Design</h3>

          <p>
            Interface clean dan minimal untuk pengalaman pengguna yang nyaman.
          </p>
        </div>

        <div class="price-card">
          <h3>High Performance</h3>

          <p>
            Fokus pada kecepatan loading, SEO dan performa website modern.
          </p>
        </div>

        <div class="price-card">
          <h3>Future Ready</h3>

          <p>
            Mengikuti perkembangan AI, teknologi dan digital ecosystem terbaru.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- WHY -->
  <section class="section">
    <div class="container">

      <h2 class="section-title">
        Why Choose Ai Mr Ferdy?
      </h2>

      <p class="section-desc">
        Dibangun untuk internet modern dengan fokus performa dan kualitas.
      </p>

      <div class="faq-item">
        <div class="faq-question">
          <span>Apakah website sudah SEO optimized?</span>
          <div class="faq-icon"></div>
        </div>

        <div class="faq-answer">
          <p>
            Ya, seluruh struktur dibangun mobile first, clean dan SEO friendly.
          </p>
        </div>
      </div>

      <div class="faq-item">
        <div class="faq-question">
          <span>Apakah fokus pada AI dan teknologi modern?</span>
          <div class="faq-icon"></div>
        </div>

        <div class="faq-answer">
          <p>
            Ya, Ai Mr Ferdy fokus pada AI, automation, internet tools dan teknologi modern.
          </p>
        </div>
      </div>

      <div class="faq-item">
        <div class="faq-question">
          <span>Apakah tersedia artikel dan tutorial?</span>
          <div class="faq-icon"></div>
        </div>

        <div class="faq-answer">
          <p>
            Tersedia berbagai artikel, tutorial dan insight digital terbaru.
          </p>
        </div>
      </div>

    </div>
  </section>





<section class=location-section><div class=container><div class=location-grid><div class=location-map><iframe allowfullscreen loading=lazy referrerpolicy=no-referrer-when-downgrade src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3959.0984370774577!2d107.74528137499827!3d-7.1145903928889895!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e68bf0056253d75%3A0xd1f4cee4cf5a42c8!2sMr.%20Ferdy!5e0!3m2!1sid!2sid!4v1789991979057!5m2!1sid!2sid"title="Lokasi AI Mr Ferdy"></iframe></div><div class=location-content><span class=badge>📍 Lokasi Kami</span><h2>AI Mr Ferdy Indonesia</h2><p>
📌 VPPX+45R Neglasari Kecamatan Ibun Kabupaten Bandung Jawa Barat 40384 Indonesia</p>
<ul class=location-list><li><li>🌐 aimrferdy.com<li>⚡ AI • SEO • Automation<li>🕒 Senin - Minggu (24 Jam)</ul><a href=/contact class=btn-location>Hubungi Kami</a></div></div></div></section>
<style>


/* LOCATION SECTION */
.location-section{padding:70px 20px;background:var(--bg)}.location-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:32px;align-items:center}.location-map{overflow:hidden;border-radius:16px;border:1px solid var(--border);background:var(--card)}.location-map iframe{width:100%;height:420px;border:0;display:block}.location-content{color:var(--text)}.location-content .badge{display:inline-block;padding:6px 14px;background:rgb(34 197 94 / .13);color:#22c55e;border-radius:30px;font-size:.9rem;margin-bottom:15px}.location-content h2{margin:0 0 15px;font-size:2rem;color:var(--text)}.location-content p{color:var(--soft);line-height:1.8;margin-bottom:24px}.location-list{list-style:none;padding:0;margin:0 0 30px}.location-list li{padding:10px 0;border-bottom:1px solid var(--border);color:var(--text)}.btn-location{display:inline-block;padding:14px 26px;background:#22c55e;color:#fff;text-decoration:none;border-radius:10px;font-weight:600;transition:.3s}.btn-location:hover{opacity:.9;transform:translateY(-2px)}@media (max-width:768px){.location-grid{grid-template-columns:1fr}.location-map iframe{height:300px}.location-content h2{font-size:1.6rem}}
</style>




  <!-- CTA -->
  <section class="cta">
    <div class="container">

      <h2>
        Explore Modern Digital Technology
      </h2>

      <p>
        AI, SEO, automation, tools digital dan website modern dalam satu ecosystem.
      </p>

      <a
        href="https://aimrferdy.com"
        class="btn btn-primary"
      >
        Visit Website
      </a>

    </div>
  </section>

</MainLayout>
