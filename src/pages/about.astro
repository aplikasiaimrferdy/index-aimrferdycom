
---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../lib/site';

const pageTitle =
  'Tentang AI Mr Ferdy | Platform AI Indonesia';

const pageDescription =
  'Kenali AI Mr Ferdy, platform AI Indonesia yang membahas AI Chat, AI tools, SEO, teknologi digital, otomatisasi, dan panduan untuk individu maupun bisnis.';
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`${SITE.url()}/about`}
>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">

        <div class="hero-left">

          <div class="hero-tag">
            TENTANG AI MR FERDY
          </div>

          <h1>
            Mengenal AI Mr Ferdy, Platform AI Indonesia
          </h1>

          <p>
            AI Mr Ferdy adalah platform teknologi digital Indonesia
            yang berfokus pada kecerdasan buatan (AI). Kami membahas
            AI Chat, berbagai AI tools, SEO, otomatisasi, pengembangan
            website, dan sumber daya digital untuk membantu individu
            maupun bisnis memanfaatkan teknologi secara lebih mudah,
            efektif, dan produktif.
          </p>

          <div class="hero-btns">
            <a
              href="https://aimrferdy.com"
              class="btn btn-primary"
            >
              Kunjungi Website
            </a>

            <a
              href="https://news.aimrferdy.com"
              class="btn btn-secondary"
            >
              Artikel & Panduan
            </a>
          </div>

        </div>

        <div class="hero-right">

          <div class="hero-card">
            <div class="hero-badge">
              ARTIFICIAL INTELLIGENCE
            </div>

            <h3>
              AI Chat & AI Tools
            </h3>

            <p>
              Mengenal teknologi AI dan berbagai alat berbasis
              kecerdasan buatan untuk mendukung pekerjaan,
              kreativitas, serta produktivitas digital.
            </p>
          </div>

          <div class="hero-card">
            <div class="hero-badge">
              DIGITAL TECHNOLOGY
            </div>

            <h3>
              SEO & Website
            </h3>

            <p>
              Informasi dan panduan mengenai pengembangan website,
              optimasi SEO, teknologi web, dan solusi digital modern.
            </p>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section">
    <div class="container">

      <h2 class="section-title">
        Siapa AI Mr Ferdy?
      </h2>

      <p class="section-desc">
        Platform AI dan teknologi digital yang menghadirkan informasi,
        panduan, serta sumber daya praktis untuk membantu pengguna
        memahami dan memanfaatkan perkembangan teknologi.
      </p>

      <div class="features">

        <div class="feature-card">
          <h3>AI Chat & Artificial Intelligence</h3>

          <p>
            Membahas perkembangan kecerdasan buatan, AI Chat,
            penggunaan AI dalam aktivitas sehari-hari, serta
            pemanfaatan teknologi AI untuk mendukung pekerjaan
            dan kreativitas.
          </p>
        </div>

        <div class="feature-card">
          <h3>SEO & Pengembangan Website</h3>

          <p>
            Menyediakan wawasan tentang optimasi mesin pencari,
            pengembangan website, desain responsif, performa web,
            dan strategi membangun kehadiran digital.
          </p>
        </div>

        <div class="feature-card">
          <h3>AI Tools & Sumber Daya Digital</h3>

          <p>
            Mengenalkan berbagai alat AI, tools online, dan sumber
            daya digital yang dapat membantu meningkatkan efisiensi,
            produktivitas, serta kebutuhan bisnis dan personal.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- MISSION -->
  <section class="section">
    <div class="container">

      <h2 class="section-title">
        Visi dan Misi
      </h2>

      <p class="section-desc">
        Membantu masyarakat Indonesia memahami dan memanfaatkan
        kecerdasan buatan serta teknologi digital secara lebih mudah,
        bijak, dan produktif.
      </p>

      <div class="pricing">

        <div class="price-card">
          <h3>Informasi yang Mudah Dipahami</h3>

          <p>
            Menyajikan informasi dan panduan teknologi AI dengan
            bahasa yang jelas agar dapat dipahami oleh pemula
            maupun pengguna yang sudah berpengalaman.
          </p>
        </div>

        <div class="price-card">
          <h3>Produktivitas Digital</h3>

          <p>
            Membantu pengguna mengenali AI tools, solusi digital,
            dan teknologi yang berpotensi mempermudah pekerjaan
            serta mendukung aktivitas bisnis.
          </p>
        </div>

        <div class="price-card">
          <h3>Inovasi dan Teknologi</h3>

          <p>
            Mengikuti perkembangan AI, SEO, pengembangan website,
            dan inovasi digital melalui informasi serta referensi
            yang relevan bagi pengguna.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- WHY -->
  <section class="section">
    <div class="container">

      <h2 class="section-title">
        Mengapa Mengenal AI Mr Ferdy?
      </h2>

      <p class="section-desc">
        Sumber informasi dan panduan seputar AI serta teknologi
        digital untuk membantu pengguna menemukan wawasan yang
        relevan dengan kebutuhan mereka.
      </p>

      <div class="faq-item">
        <div class="faq-question">
          <span>Apa itu AI Mr Ferdy?</span>
          <div class="faq-icon"></div>
        </div>

        <div class="faq-answer">
          <p>
            AI Mr Ferdy adalah platform digital Indonesia yang
            berfokus pada informasi kecerdasan buatan, AI Chat,
            berbagai AI tools, SEO, pengembangan website,
            dan teknologi digital.
          </p>
        </div>
      </div>

      <div class="faq-item">
        <div class="faq-question">
          <span>Apa saja topik yang dibahas AI Mr Ferdy?</span>
          <div class="faq-icon"></div>
        </div>

        <div class="faq-answer">
          <p>
            Topik yang dibahas meliputi AI Chat, AI tools,
            pemanfaatan kecerdasan buatan, produktivitas digital,
            SEO, otomatisasi, pengembangan website, dan
            berbagai perkembangan teknologi.
          </p>
        </div>
      </div>

      <div class="faq-item">
        <div class="faq-question">
          <span>Siapa yang dapat memanfaatkan informasi di sini?</span>
          <div class="faq-icon"></div>
        </div>

        <div class="faq-answer">
          <p>
            Informasi AI Mr Ferdy ditujukan bagi pelajar, kreator
            konten, profesional, pemilik usaha, pengembang website,
            dan siapa pun yang ingin mempelajari AI serta
            memanfaatkan teknologi digital.
          </p>
        </div>
      </div>

      <div class="faq-item">
        <div class="faq-question">
          <span>Di mana saya dapat membaca artikel dan panduan?</span>
          <div class="faq-icon"></div>
        </div>

        <div class="faq-answer">
          <p>
            Kunjungi
            <a href="https://news.aimrferdy.com">
              AI Mr Ferdy News
            </a>
            untuk menjelajahi artikel, informasi, dan panduan
            seputar AI serta teknologi digital.
          </p>
        </div>
      </div>

    </div>
  </section>

  <section class=location-section><div class=container><div class=location-grid><div class=location-map><iframe allowfullscreen loading=lazy referrerpolicy=no-referrer-when-downgrade src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3959.0984370774577!2d107.74528137499827!3d-7.1145903928889895!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e68bf0056253d75%3A0xd1f4cee4cf5a42c8!2sMr.%20Ferdy!5e0!3m2!1sid!2sid!4v1789991979057!5m2!1sid!2sid"title="Lokasi AI Mr Ferdy"></iframe></div><div class=location-content><span class=badge>📍 Lokasi Kami</span><h2>AI Mr Ferdy Indonesia</h2><p>
AI Mr Ferdy merupakan platform digital yang membahas kecerdasan buatan dan teknologi. Informasi lokasi berikut mengacu pada titik peta yang ditampilkan.</p>
<ul class=location-list><li>🌐 aimrferdy.com</li><li>⚡ AI Chat • AI Tools • SEO</li><li>📚 Panduan & Sumber Daya Digital</li></ul><a href=/contact class=btn-location>Hubungi Kami</a></div></div></div></section>
<style>


/* LOCATION SECTION */
.location-section{padding:70px 20px;background:var(--bg)}.location-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:32px;align-items:center}.location-map{overflow:hidden;border-radius:16px;border:1px solid var(--border);background:var(--card)}.location-map iframe{width:100%;height:420px;border:0;display:block}.location-content{color:var(--text)}.location-content .badge{display:inline-block;padding:6px 14px;background:rgb(34 197 94 / .13);color:#22c55e;border-radius:30px;font-size:.9rem;margin-bottom:15px}.location-content h2{margin:0 0 15px;font-size:2rem;color:var(--text)}.location-content p{color:var(--soft);line-height:1.8;margin-bottom:24px}.location-list{list-style:none;padding:0;margin:0 0 30px}.location-list li{padding:10px 0;border-bottom:1px solid var(--border);color:var(--text)}.btn-location{display:inline-block;padding:14px 26px;background:#22c55e;color:#fff;text-decoration:none;border-radius:10px;font-weight:600;transition:.3s}.btn-location:hover{opacity:.9;transform:translateY(-2px)}@media (max-width:768px){.location-grid{grid-template-columns:1fr}.location-map iframe{height:300px}.location-content h2{font-size:1.6rem}}
</style>

  <!-- CTA -->
  <section class="cta">
    <div class="container">

      <h2>
        Jelajahi AI dan Teknologi Digital
      </h2>

      <p>
        Temukan informasi AI Chat, AI tools, SEO, produktivitas,
        dan teknologi digital untuk mendukung kebutuhan pribadi
        maupun bisnis bersama AI Mr Ferdy.
      </p>

      <a
        href="https://aimrferdy.com"
        class="btn btn-primary"
      >
        Kunjungi Website Resmi
      </a>

    </div>
  </section>

</MainLayout>
