
---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../lib/site';

const pageTitle =
  'People Behind AI Mr. Ferdy - Founder, Partner & Contributors';

const pageDescription =
  'Meet the people behind AI Mr. Ferdy, including its founder, partners, and contributors building practical AI resources for digital creation.';
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`${SITE.url()}/about`}
>

  <main class="team-page">

    <section class="team-hero">
      <div class="team-container">
        <span class="eyebrow">AI Mr. Ferdy</span>

        <h1>People Behind AI Mr. Ferdy</h1>

        <p>
          Meet the people behind AI Mr. Ferdy — a digital project exploring
          practical applications of artificial intelligence for digital
          creation, websites, content, automation, SEO, and online business.
        </p>
      </div>
    </section>

    <section class="team-section">
      <div class="team-container">

        <div class="section-heading">
          <span class="eyebrow">Founder</span>
          <h2>Building AI Mr. Ferdy</h2>
        </div>

        <article class="team-card" id="ferdy">

          <div class="team-avatar">
            F
          </div>

          <div class="team-content">

            <span class="role">Founder</span>

            <h3>Ferdy</h3>

            <p class="position">
              Founder of AI Mr. Ferdy
            </p>

            <p>
              Ferdy is the founder of AI Mr. Ferdy, a digital project focused
              on exploring and applying artificial intelligence to modern
              digital creation.
            </p>

            <p>
              His work covers AI tools, website creation, content production,
              automation, SEO, e-commerce, and online business.
            </p>

            <a
              href="https://www.linkedin.com/in/mrferdy/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Connect with Ferdy on LinkedIn"
            >
              LinkedIn
            </a>

          </div>
        </article>

        <div class="section-heading partner-heading">
          <span class="eyebrow">Partner</span>
          <h2>Collaborating on the Project</h2>
        </div>

        <article class="team-card" id="sultan">

          <div class="team-avatar">
            A
          </div>

          <div class="team-content">

            <span class="role">Partner</span>

            <h3>Ai Mr. Sultan</h3>

            <p class="position">
              Partner of AI Mr. Ferdy
            </p>

            <p>
              Ai Mr. Sultan collaborates with AI Mr. Ferdy on projects and
              activities related to digital creation and the development of
              the AI Mr. Ferdy ecosystem.
            </p>

            <p>
              Her involvement supports the development of ideas, content,
              and digital initiatives connected with the project.
            </p>

            <a
              href="https://www.linkedin.com/in/ai-mr-sultan-5270aa401"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Connect with Ai Mr. Sultan on LinkedIn"
            >
              LinkedIn
            </a>

          </div>
        </article>

        <div class="section-heading">
          <span class="eyebrow">Contributors</span>
          <h2>Growing the AI Mr. Ferdy Ecosystem</h2>
        </div>

        <div class="contributors">

          <p>
            AI Mr. Ferdy also welcomes contributors and collaborators who
            share an interest in artificial intelligence, digital technology,
            content creation, websites, automation, and SEO.
          </p>

        </div>

        <div class="about-team">

          <span class="eyebrow">
            About AI Mr. Ferdy
          </span>

          <h2>Exploring Practical AI</h2>

          <p>
            AI Mr. Ferdy is a digital platform focused on practical
            applications of artificial intelligence for modern digital
            creation.
          </p>

          <div class="topics">
            <span>AI Tools</span>
            <span>Website Creation</span>
            <span>Content Production</span>
            <span>Automation</span>
            <span>SEO</span>
            <span>Online Business</span>
            <span>E-commerce</span>
            <span>Digital Innovation</span>
          </div>

          <a class="primary-link" href="/tools/">
            Explore AI Tools
          </a>

        </div>

      </div>
    </section>

  </main>

</MainLayout>

<style>
.team-page{
  width:100%;
}

.team-container{
  width:100%;
  max-width:1280px;
  margin:0 auto;
  padding:0 24px;
  box-sizing:border-box;
}

.team-hero{
  padding:120px 0 80px;
  text-align:center;
}

.team-hero .team-container{
  max-width:900px;
}

.eyebrow{
  display:inline-block;
  margin-bottom:12px;
  font-size:.8rem;
  font-weight:700;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:#38bdf8;
}

.team-hero h1{
  margin:0 0 20px;
  font-size:clamp(2.5rem,6vw,5rem);
  line-height:1.05;
  color:var(--text);
}

.team-hero p{
  margin:0 auto;
  max-width:760px;
  font-size:1.1rem;
  line-height:1.8;
  color:var(--soft);
}

.team-section{
  padding:40px 0 100px;
}

.section-heading{
  margin:0 0 28px;
}

.section-heading h2,
.about-team h2{
  margin:0;
  color:var(--text);
  font-size:clamp(1.8rem,3vw,2.6rem);
}

.team-card{
  display:grid;
  grid-template-columns:120px 1fr;
  gap:32px;
  padding:40px;
  margin-bottom:90px;
  border:1px solid var(--border);
  border-radius:28px;
  background:var(--card);
}

.team-avatar{
  width:120px;
  height:120px;
  display:grid;
  place-items:center;
  border-radius:50%;
  font-size:3rem;
  font-weight:800;
  color:var(--text);
  background:linear-gradient(135deg,#0ea5e9,#6366f1);
}

.team-content .role{
  font-size:.8rem;
  font-weight:700;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:#38bdf8;
}

.team-content h3{
  margin:8px 0 4px;
  font-size:2rem;
  color:var(--text);
}

.position{
  margin:0 0 20px;
  color:var(--soft);
  font-weight:600;
}

.team-content p,
.contributors p,
.about-team p{
  max-width:760px;
  color:var(--soft);
  line-height:1.8;
}

.team-content a,
.primary-link{
  display:inline-block;
  margin-top:10px;
  color:#38bdf8;
  font-weight:700;
  text-decoration:none;
}

.partner-heading{
  margin-top:20px;
}

.contributors{
  padding:32px;
  margin-bottom:90px;
  border:1px solid var(--border);
  border-radius:24px;
  background:var(--card);
}

.about-team{
  padding:50px;
  border:1px solid var(--border);
  border-radius:28px;
  background:var(--card);
}

.topics{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin:28px 0;
}

.topics span{
  padding:9px 14px;
  border:1px solid var(--border);
  border-radius:999px;
  color:var(--soft);
  font-size:.9rem;
}

.primary-link{
  padding:13px 20px;
  border-radius:12px;
  background:#0ea5e9;
  color:#fff;
}

@media(max-width:700px){
  .team-hero{
    padding:80px 0 50px;
  }

  .team-card{
    grid-template-columns:1fr;
    padding:28px;
  }

  .team-avatar{
    width:90px;
    height:90px;
    font-size:2.2rem;
  }

  .about-team{
    padding:30px;
  }
}
</style>
