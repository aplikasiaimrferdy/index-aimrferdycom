---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const products = await getCollection('product');

const featuredProducts = products
  .filter(product => product.data.featured)
  .map(product => {
    const displayImage =
      product.data.image?.trim()
      || product.data.gallery?.find(img => img?.trim())
      || `/api/og/${product.slug}.svg`;

    return {
      ...product,
      displayImage
    };
  });
---

<MainLayout
  title="Products | AI PRINT"
  description="Browse premium POD marketplace products."
>

<section class="hero">

  <div class="hero-content">

    <span class="badge">
      PREMIUM POD MARKETPLACE
    </span>

    <h1>
      Discover Modern
      <br />
      Print-On-Demand Designs
    </h1>

    <p>
      Ultra fast Astro ecommerce storefront with
      modern UI, responsive layouts, and SEO
      optimized architecture.
    </p>

  </div>

</section>

<section class="products-section">

  <div class="section-head">

    <div>

      <h2>
        Featured Products
      </h2>

      <p>
        Trending marketplace designs
      </p>

    </div>

    <div class="filters">

      <button class="active">
        Trending
      </button>

      <button>
        Latest
      </button>

      <button>
        Popular
      </button>

    </div>

  </div>

  <div class="products-grid">

    {
      featuredProducts.map(product => (

        <a
          href={`/product/${product.slug}`}
          class="card"
        >

          <div class="card-image">

            <img
              src={product.displayImage}
              alt={product.data.title}
              loading="lazy"
            />

          </div>

          <div class="card-body">

            <div class="card-top">

              <span class="tag">
                FEATURED
              </span>

              <span class="category">
                {product.data.category}
              </span>

            </div>

            <h2>
              {product.data.title}
            </h2>

            <p class="desc">
              {product.data.description}
            </p>

            <div class="price-wrap">

              <span class="price">
                {product.data.price}
              </span>

              {
                product.data.oldPrice && (
                  <span class="old-price">
                    {product.data.oldPrice}
                  </span>
                )
              }

            </div>

          </div>

        </a>

      ))
    }

  </div>

</section>
<style is:global>
.hero{
  position:relative;
  overflow:hidden;
  border-radius:24px;
  padding:90px 50px;
  margin-bottom:60px;
  background:
    radial-gradient(
      circle at top right,
      rgba(37,99,235,.18),
      transparent 35%
    ),
    var(--card);
  color:var(--text);
  border:1px solid var(--border);
  box-shadow:0 20px 50px rgba(0,0,0,.15);
}

.hero::before{
  content:"";
  position:absolute;
  inset:0;
  background:
    radial-gradient(
      circle at 80% 20%,
      rgba(6,182,212,.10),
      transparent 40%
    );
  pointer-events:none;
}

.hero-content{
  position:relative;
  z-index:2;
  max-width:720px;
}

.badge{
  display:inline-flex;
  padding:10px 16px;
  border-radius:999px;
  background:rgba(37,99,235,.08);
  border:1px solid var(--border);
  color:#38bdf8;
  font-size:13px;
  font-weight:800;
  margin-bottom:20px;
}

.hero h1{
  color:var(--text);
  font-size:68px;
  line-height:1;
  margin:0 0 24px;
}

.hero p{
  color:var(--soft);
  font-size:18px;
  line-height:1.9;
  margin:0;
}

.products-section{
  margin-top:30px;
}

.section-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  margin-bottom:34px;
}

.section-head h2{
  color:var(--text);
  font-size:42px;
  margin:0 0 6px;
}

.section-head p{
  color:var(--soft);
  margin:0;
}

.filters{
  display:flex;
  flex-wrap:wrap;
  gap:12px;
}

.filters button{
  border:1px solid var(--border);
  background:var(--card);
  color:var(--text);
  padding:12px 18px;
  border-radius:12px;
  font-weight:700;
  cursor:pointer;
  transition:
    background .25s ease,
    border-color .25s ease,
    color .25s ease,
    transform .25s ease;
}

.filters button:hover{
  background:rgba(37,99,235,.10);
  border-color:#2563eb;
  transform:translateY(-1px);
}

.filters .active{
  background:linear-gradient(135deg,#1d4ed8,#0891b2);
  color:#fff;
  border-color:transparent;
}

.products-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:24px;
}

.card{
  display:block;
  background:var(--card);
  color:var(--text);
  border:1px solid var(--border);
  border-radius:24px;
  overflow:hidden;
  box-shadow:0 15px 40px rgba(0,0,0,.12);
  transition:
    transform .25s ease,
    border-color .25s ease,
    background .25s ease,
    box-shadow .25s ease;
}

.card:hover{
  transform:translateY(-6px);
  border-color:#2563eb;
  box-shadow:0 20px 50px rgba(37,99,235,.16);
}

.card-image{
  overflow:hidden;
  background:rgba(15,23,42,.35);
}

.card-image img{
  display:block;
  width:100%;
  height:360px;
  object-fit:cover;
  transition:transform .4s ease;
}

.card:hover img{
  transform:scale(1.05);
}

.card-body{
  padding:22px;
  background:var(--card);
}

.card-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:14px;
}

.tag{
  display:inline-flex;
  background:rgba(37,99,235,.10);
  color:#38bdf8;
  padding:8px 12px;
  border:1px solid rgba(37,99,235,.20);
  border-radius:999px;
  font-size:12px;
  font-weight:800;
}

.category{
  color:var(--soft);
  font-size:13px;
  font-weight:700;
}

.card h2{
  color:var(--text);
  font-size:22px;
  line-height:1.3;
  margin:0 0 12px;
}

.desc{
  color:var(--soft);
  line-height:1.8;
  margin:0 0 18px;
  font-size:15px;
}

.price-wrap{
  display:flex;
  align-items:center;
  gap:12px;
}

.price{
  color:var(--text);
  font-size:28px;
  font-weight:900;
}

.old-price{
  color:var(--soft);
  text-decoration:line-through;
  opacity:.7;
}

@media(max-width:1200px){

  .products-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .hero h1{
    font-size:54px;
  }

}

@media(max-width:768px){

  .hero{
    padding:60px 24px;
  }

  .hero h1{
    font-size:40px;
  }

  .hero p{
    font-size:16px;
  }

  .section-head{
    flex-direction:column;
    align-items:flex-start;
  }

  .section-head h2{
    font-size:34px;
  }

  .products-grid{
    grid-template-columns:1fr;
  }

  .card-image img{
    height:320px;
  }

}


</style>
</MainLayout>
