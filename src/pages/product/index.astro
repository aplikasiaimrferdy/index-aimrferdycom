---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const products = await getCollection('product');

const featuredProducts = products
  .filter(product => product.data.featured)
  .map(product => {
    const displayImage =
      product.data.image?.trim()
      || product.data.gallery?.find(img => img?.trim())
      || `/api/og/${product.slug}.svg`;

    return {
      ...product,
      displayImage
    };
  });
---

<MainLayout
  title="Products | AI Mr. Ferdy"
  description="Explore premium digital and print-on-demand products from AI Mr. Ferdy."
>

<div class="container-page">

  <section class="products-hero">

    <div class="hero-content">

      <span class="hero-badge">
        AI MR. FERDY STORE
      </span>

      <h1>
        Discover
        <span>Creative Products</span>
      </h1>

      <p>
        Explore curated products, digital creations, and
        modern print-on-demand designs built for creators.
      </p>

      <div class="hero-actions">
        <a href="#featured" class="hero-button">
          Explore Products
        </a>

        <span class="hero-note">
          Curated for modern creators
        </span>
      </div>

    </div>

    <div class="hero-visual">

      {
        featuredProducts[0] && (
          <div class="hero-image-main">
            <img
              src={featuredProducts[0].displayImage}
              alt={featuredProducts[0].data.title}
            />
          </div>
        )
      }

      {
        featuredProducts[1] && (
          <div class="hero-image-small">
            <img
              src={featuredProducts[1].displayImage}
              alt={featuredProducts[1].data.title}
            />
          </div>
        )
      }

      <div class="hero-glow"></div>

    </div>

  </section>


  <section class="products-section" id="featured">

    <div class="section-head">

      <div class="section-title">

        <span>
          CURATED COLLECTION
        </span>

        <h2>
          Featured Products
        </h2>

        <p>
          Selected designs and products worth exploring.
        </p>

      </div>

      <div class="filters">

        <button class="active">
          Trending
        </button>

        <button>
          Latest
        </button>

        <button>
          Popular
        </button>

      </div>

    </div>


    <div class="products-grid">

      {
        featuredProducts.map(product => (

          <a
            href={`/product/${product.slug}`}
            class="product-card"
          >

            <div class="product-image">

              <img
                src={product.displayImage}
                alt={product.data.title}
                loading="lazy"
              />

              <span class="product-label">
                FEATURED
              </span>

              <span class="product-view">
                View
              </span>

            </div>


            <div class="product-body">

              <div class="product-meta">

                <span>
                  {product.data.category}
                </span>

                <span>
                  Product
                </span>

              </div>

              <h2>
                {product.data.title}
              </h2>

              <p>
                {product.data.description}
              </p>

              <div class="product-footer">

                <span class="price">
                  {product.data.price}
                </span>

                {
                  product.data.oldPrice && (
                    <span class="old-price">
                      {product.data.oldPrice}
                    </span>
                  )
                }

                <span class="arrow">
                  →
                </span>

              </div>

            </div>

          </a>

        ))
      }

    </div>

  </section>

</div>


<style is:global>

.container-page{
  width:100%;
  max-width:1280px;
  margin:0 auto;
  padding:96px 24px 60px;
  box-sizing:border-box;
}


/* =========================================================
   HERO
========================================================= */

.products-hero{
  position:relative;
  min-height:520px;
  display:grid;
  grid-template-columns:1fr 1fr;
  align-items:center;
  gap:60px;
  padding:70px;
  overflow:hidden;
  border:1px solid var(--border);
  border-radius:32px;
  background:
    radial-gradient(
      circle at 85% 20%,
      rgba(37,99,235,.20),
      transparent 35%
    ),
    radial-gradient(
      circle at 20% 100%,
      rgba(6,182,212,.12),
      transparent 40%
    ),
    var(--card);
  box-shadow:0 25px 70px rgba(0,0,0,.16);
}

.hero-content{
  position:relative;
  z-index:3;
  max-width:620px;
}

.hero-badge{
  display:inline-flex;
  align-items:center;
  padding:9px 14px;
  margin-bottom:22px;
  border:1px solid var(--border);
  border-radius:999px;
  background:rgba(37,99,235,.08);
  color:#38bdf8;
  font-size:12px;
  font-weight:800;
  letter-spacing:.08em;
}

.products-hero h1{
  margin:0;
  color:var(--text);
  font-size:64px;
  line-height:1.02;
  letter-spacing:-.04em;
}

.products-hero h1 span{
  display:block;
  background:linear-gradient(90deg,#38bdf8,#60a5fa);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.products-hero p{
  max-width:560px;
  margin:26px 0 0;
  color:var(--soft);
  font-size:18px;
  line-height:1.8;
}

.hero-actions{
  display:flex;
  align-items:center;
  gap:18px;
  margin-top:32px;
}

.hero-button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:14px 22px;
  border-radius:12px;
  background:linear-gradient(135deg,#1d4ed8,#0891b2);
  color:#fff;
  font-size:14px;
  font-weight:800;
  text-decoration:none;
  transition:transform .25s ease,box-shadow .25s ease;
}

.hero-button:hover{
  transform:translateY(-2px);
  box-shadow:0 12px 30px rgba(37,99,235,.25);
}

.hero-note{
  color:var(--soft);
  font-size:13px;
}


/* =========================================================
   HERO VISUAL
========================================================= */

.hero-visual{
  position:relative;
  min-height:400px;
}

.hero-image-main{
  position:absolute;
  z-index:2;
  top:10px;
  right:40px;
  width:290px;
  height:380px;
  overflow:hidden;
  border:1px solid var(--border);
  border-radius:24px;
  transform:rotate(4deg);
  box-shadow:0 25px 60px rgba(0,0,0,.28);
}

.hero-image-main img{
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
}

.hero-image-small{
  position:absolute;
  z-index:3;
  bottom:20px;
  left:20px;
  width:190px;
  height:250px;
  overflow:hidden;
  border:1px solid var(--border);
  border-radius:20px;
  transform:rotate(-7deg);
  box-shadow:0 20px 45px rgba(0,0,0,.28);
}

.hero-image-small img{
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
}

.hero-glow{
  position:absolute;
  width:300px;
  height:300px;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  border-radius:50%;
  background:rgba(37,99,235,.18);
  filter:blur(70px);
}


/* =========================================================
   PRODUCTS
========================================================= */

.products-section{
  margin-top:90px;
}

.section-head{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:30px;
  margin-bottom:32px;
}

.section-title > span{
  color:#38bdf8;
  font-size:12px;
  font-weight:800;
  letter-spacing:.1em;
}

.section-title h2{
  margin:8px 0 6px;
  color:var(--text);
  font-size:42px;
  line-height:1.1;
}

.section-title p{
  margin:0;
  color:var(--soft);
  font-size:15px;
}


/* =========================================================
   FILTER
========================================================= */

.filters{
  display:flex;
  align-items:center;
  gap:8px;
  padding:6px;
  border:1px solid var(--border);
  border-radius:14px;
  background:var(--card);
}

.filters button{
  border:0;
  padding:10px 15px;
  border-radius:9px;
  background:transparent;
  color:var(--soft);
  font-size:13px;
  font-weight:700;
  cursor:pointer;
  transition:all .25s ease;
}

.filters button:hover{
  color:var(--text);
  background:rgba(37,99,235,.08);
}

.filters .active{
  background:linear-gradient(135deg,#1d4ed8,#0891b2);
  color:#fff;
}


/* =========================================================
   PRODUCT GRID
========================================================= */

.products-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:24px;
}

.product-card{
  display:block;
  overflow:hidden;
  border:1px solid var(--border);
  border-radius:24px;
  background:var(--card);
  color:var(--text);
  text-decoration:none;
  box-shadow:0 12px 35px rgba(0,0,0,.10);
  transition:
    transform .3s ease,
    border-color .3s ease,
    box-shadow .3s ease;
}

.product-card:hover{
  transform:translateY(-7px);
  border-color:rgba(37,99,235,.5);
  box-shadow:0 22px 50px rgba(37,99,235,.14);
}


/* =========================================================
   PRODUCT IMAGE
========================================================= */

.product-image{
  position:relative;
  aspect-ratio:4/5;
  overflow:hidden;
  background:rgba(15,23,42,.35);
}

.product-image img{
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
  transition:transform .45s ease;
}

.product-card:hover .product-image img{
  transform:scale(1.06);
}

.product-label{
  position:absolute;
  top:14px;
  left:14px;
  padding:7px 10px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:999px;
  background:rgba(0,0,0,.55);
  color:#fff;
  font-size:10px;
  font-weight:800;
  letter-spacing:.06em;
  backdrop-filter:blur(10px);
}

.product-view{
  position:absolute;
  right:14px;
  bottom:14px;
  padding:8px 12px;
  border-radius:10px;
  background:rgba(0,0,0,.55);
  color:#fff;
  font-size:12px;
  font-weight:700;
  opacity:0;
  transform:translateY(6px);
  transition:all .25s ease;
  backdrop-filter:blur(10px);
}

.product-card:hover .product-view{
  opacity:1;
  transform:translateY(0);
}


/* =========================================================
   PRODUCT BODY
========================================================= */

.product-body{
  padding:20px;
}

.product-meta{
  display:flex;
  justify-content:space-between;
  gap:10px;
  margin-bottom:10px;
  color:var(--soft);
  font-size:11px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.05em;
}

.product-body h2{
  margin:0 0 10px;
  color:var(--text);
  font-size:20px;
  line-height:1.3;
}

.product-body p{
  display:-webkit-box;
  overflow:hidden;
  margin:0 0 20px;
  color:var(--soft);
  font-size:14px;
  line-height:1.7;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
}

.product-footer{
  display:flex;
  align-items:center;
  gap:10px;
}

.price{
  color:var(--text);
  font-size:22px;
  font-weight:900;
}

.old-price{
  color:var(--soft);
  font-size:13px;
  text-decoration:line-through;
}

.arrow{
  margin-left:auto;
  color:#38bdf8;
  font-size:20px;
  transition:transform .25s ease;
}

.product-card:hover .arrow{
  transform:translateX(5px);
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1100px){

  .products-hero{
    grid-template-columns:1fr;
    padding:60px;
  }

  .hero-visual{
    min-height:430px;
  }

  .hero-image-main{
    right:15%;
  }

  .hero-image-small{
    left:15%;
  }

  .products-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

}

@media(max-width:768px){

  .container-page{
    padding:80px 18px 40px;
  }

  .products-hero{
    padding:42px 24px;
    border-radius:24px;
    gap:30px;
  }

  .products-hero h1{
    font-size:44px;
  }

  .products-hero p{
    font-size:16px;
  }

  .hero-actions{
    align-items:flex-start;
    flex-direction:column;
  }

  .hero-visual{
    min-height:360px;
  }

  .hero-image-main{
    width:220px;
    height:300px;
    right:8%;
  }

  .hero-image-small{
    width:150px;
    height:210px;
    left:5%;
    bottom:10px;
  }

  .products-section{
    margin-top:65px;
  }

  .section-head{
    align-items:flex-start;
    flex-direction:column;
  }

  .section-title h2{
    font-size:34px;
  }

  .filters{
    width:100%;
  }

  .filters button{
    flex:1;
  }

  .products-grid{
    grid-template-columns:1fr;
    gap:18px;
  }

}

@media(max-width:480px){

  .products-hero h1{
    font-size:38px;
  }

  .hero-image-main{
    right:2%;
  }

  .hero-image-small{
    left:0;
  }

}
</style>

</MainLayout>

