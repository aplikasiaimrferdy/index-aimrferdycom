---
const modules = Object.entries(
  import.meta.glob('/src/pages/tools/**/*.astro', { eager: true })
);

const tools = modules
  .map(([file, mod]) => {
    if (!mod.meta) return null;

    let url = file
      .split('/pages')[1]
      ?.replace('.astro', '') || '';

    if (!url.startsWith('/')) {
      url = '/' + url;
    }

    return {
      url,
      ...mod.meta
    };
  })
  .filter(Boolean);

const currentUrl =
  Astro.url.pathname.replace(/\/$/, '');

const currentTool =
  tools.find(t => t.url === currentUrl);

let relatedTools = [];

if (currentTool) {
  relatedTools = tools
    .filter(t =>
      t.category === currentTool.category &&
      t.url !== currentUrl
    )
    .slice(0, 5);
}

if (relatedTools.length < 3) {
  relatedTools = tools
    .filter(t => t.url !== currentUrl)
    .slice(0, 5);
}
---

{relatedTools.length > 0 && (
  <section class="related-tools">

    <h2>
      Tools Terkait
    </h2>

    <div class="related-tools-grid">

      {relatedTools.map(tool => (

        <a
          href={tool.url}
          class="related-tool-card"
        >

          {tool.icon && (
            <div class="related-tool-icon">
              {tool.icon}
            </div>
          )}

          <h3>
            {tool.title}
          </h3>

          {tool.description && (
            <p>
              {tool.description}
            </p>
          )}

        </a>

      ))}

    </div>

  </section>
)}

<style>
.related-tools {
  width: 100%;
  max-width: 100%;
  margin-top: 40px;
  box-sizing: border-box;
}

.related-tools h2 {
  margin: 0 0 15px;
  font-size: 20px;
}

.related-tools-grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 15px;
}

.related-tool-card {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 15px;
  border-radius: 12px;
  background: var(--card);
  border: 1px solid var(--border);
  text-decoration: none;
  color: var(--text);
  transition: .2s ease;
}

.related-tool-card:hover {
  border-color: var(--accent);
  transform: translateY(-3px);
}

.related-tool-card h3 {
  margin: 0 0 5px;
  font-size: .95rem;
}

.related-tool-card p {
  margin: 0;
  font-size: .8rem;
  color: var(--text-soft);
}

.related-tool-icon {
  margin-bottom: 8px;
  font-size: 24px;
}
</style>---
