---
const modules = Object.entries(
  import.meta.glob('/src/pages/tools/**/*.astro', { eager: true })
);

const tools = modules
  .map(([file, mod]) => {
    if (!mod.meta) return null;

    let url = file.split('/pages')[1]?.replace('.astro', '') || '';

    if (!url.startsWith('/')) url = '/' + url;

    return { url, ...mod.meta };
  })
  .filter(Boolean);

const currentUrl = Astro.url.pathname.replace(/\/$/, '');

const currentTool = tools.find(t => t.url === currentUrl);

let relatedTools = [];

if (currentTool) {
  relatedTools = tools
    .filter(t =>
      t.category === currentTool.category &&
      t.url !== currentUrl
    )
    .slice(0, 5);
}

if (relatedTools.length < 3) {
  relatedTools = tools
    .filter(t => t.url !== currentUrl)
    .slice(0, 5);
}
---

{relatedTools.length > 0 && (
  <section class="page-tools related-tools">
    <h2>Tools Terkait</h2>

    <div class="related-tools-grid">
      {relatedTools.map(tool => (
        <a href={tool.url} class="related-tool-card">
          <h3>{tool.title}</h3>
          <p>{tool.description}</p>
        </a>
      ))}
    </div>
  </section>
)}

<style>
.related-tools {
  width: 100%;
  margin-top: 40px;
}

.related-tools h2 {
  margin: 0 0 15px;
  font-size: 20px;
}

.related-tools-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 15px;
}

.related-tool-card {
  display: block;
  padding: 15px;
  border-radius: 12px;
  background: var(--card);
  border: 1px solid var(--border);
  text-decoration: none;
  color: var(--text);
  transition: 0.2s;
}

.related-tool-card:hover {
  border-color: var(--accent);
  transform: translateY(-3px);
}

.related-tool-card h3 {
  margin: 0 0 5px;
  font-size: 0.95rem;
}

.related-tool-card p {
  margin: 0;
  font-size: 0.8rem;
  color: var(--text-soft);
}
</style>
