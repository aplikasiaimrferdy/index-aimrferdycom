---
interface Props {
  title: string;
  url?: string;
}

const { title, url = Astro.url.href } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
---

<div class="floating-share" aria-label="Bagikan artikel">
  <div class="share-menu" id="shareMenu">

    <a
      href={`https://wa.me/?text=${encodedTitle}%20${encodedUrl}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="WhatsApp"
      title="WhatsApp"
    >
      <svg viewBox="0 0 24 24">
        <path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.5 0 .1 5.4.1 12c0 2.1.5 4.1 1.6 5.9L0 24l6.2-1.6a12 12 0 0 0 5.9 1.5h.1c6.6 0 11.9-5.4 11.9-12 0-3.2-1.3-6.2-3.6-8.4Zm-8.4 18.4c-1.8 0-3.6-.5-5.1-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12.1 22Zm5.4-7.3c-.3-.2-1.7-.8-2-.9-.3-.1-.5-.2-.7.2-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1-1.6-.8-2.7-1.4-3.8-3.2-.3-.5.3-.4.8-1.3.1-.2.1-.4 0-.6-.1-.2-.7-1.7-.9-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.6s1.1 3 1.3 3.2c.2.2 2.1 3.2 5.1 4.5 1.9.8 2.6.9 3.5.8.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.3.1-1.4-.1-.1-.3-.2-.6-.3Z"/>
      </svg>
    </a>

    <a
      href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Facebook"
      title="Facebook"
    >
      <svg viewBox="0 0 24 24">
        <path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.5 1.6-1.5h1.7V4.9c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H8v3h2.6v8h2.9Z"/>
      </svg>
    </a>

    <a
      href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="X"
      title="X"
    >
      <svg viewBox="0 0 24 24">
        <path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.2-8.2L2.8 2h6.4l4.4 5.8L18.9 2Zm-1.1 17.7h1.7L8.3 4.2H6.5l11.3 15.5Z"/>
      </svg>
    </a>

    <a
      href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn"
      title="LinkedIn"
    >
      <svg viewBox="0 0 24 24">
        <path d="M5.2 3.3A2.2 2.2 0 1 1 .8 3.3a2.2 2.2 0 0 1 4.4 0ZM1.1 7.1h4.1V20H1.1V7.1Zm6.7 0h3.9v1.8h.1c.5-1 1.8-2.1 3.7-2.1 4 0 4.7 2.6 4.7 6V20h-4.1v-6.4c0-1.5 0-3.4-2.1-3.4s-2.4 1.6-2.4 3.3V20H7.8V7.1Z"/>
      </svg>
    </a>

    <a
      href={`https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Telegram"
      title="Telegram"
    >
      <svg viewBox="0 0 24 24">
        <path d="M21.8 3.2 18.4 20c-.3 1.2-.9 1.5-1.8.9l-5-3.7-2.4 2.3c-.3.3-.5.5-1 .5l.4-5.1 9.2-8.3c.4-.4-.1-.6-.6-.2L6 13.6l-4.9-1.5c-1.1-.3-1.1-1.1.2-1.6L20.4 3c.9-.3 1.7.2 1.4.2Z"/>
      </svg>
    </a>

    <button
      type="button"
      id="copyShareLink"
      aria-label="Copy link"
      title="Copy link"
    >
      <svg viewBox="0 0 24 24">
        <path d="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1Zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2Zm0 16H8V7h11v14Z"/>
      </svg>
    </button>

  </div>

  <button
    type="button"
    class="floating-btn share-toggle"
    id="shareToggle"
    aria-label="Bagikan"
    title="Bagikan"
  >
    <svg viewBox="0 0 24 24">
      <path d="M18 16.1c-.8 0-1.5.3-2 .8L8.9 12.8c.1-.3.1-.5.1-.8s0-.5-.1-.8L16 7.1c.5.5 1.2.8 2 .8a3 3 0 1 0-3-3c0 .3 0 .5.1.8L8 9.9a3 3 0 1 0 0 4.2l7.1 4.2c-.1.2-.1.5-.1.7a3 3 0 1 0 3-2.9Z"/>
    </svg>
  </button>

  <button
    type="button"
    class="floating-btn back-top"
    id="backTop"
    aria-label="Kembali ke atas"
    title="Kembali ke atas"
  >
    <svg viewBox="0 0 24 24">
      <path d="m12 4-8 8 1.4 1.4L11 7.8V20h2V7.8l5.6 5.6L20 12l-8-8Z"/>
    </svg>
  </button>
</div>

<script>
  const shareToggle = document.getElementById('shareToggle');
  const shareMenu = document.getElementById('shareMenu');
  const backTop = document.getElementById('backTop');
  const copyShareLink = document.getElementById('copyShareLink');

  shareToggle?.addEventListener('click', () => {
    shareMenu?.classList.toggle('active');
  });

  copyShareLink?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);

      shareToggle?.classList.add('copied');

      setTimeout(() => {
        shareToggle?.classList.remove('copied');
        shareMenu?.classList.remove('active');
      }, 1200);
    } catch {}
  });

  backTop?.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  });

  window.addEventListener('scroll', () => {
    if (window.scrollY > 500) {
      backTop?.classList.add('visible');
    } else {
      backTop?.classList.remove('visible');
    }
  });
</script>

<style>
  .floating-share {
    position: fixed;
    right: 22px;
    bottom: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .floating-btn,
  .share-menu a,
  .share-menu button {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--card);
    color: var(--text);
    box-shadow: 0 8px 25px rgba(0,0,0,.18);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    cursor: pointer;
    transition: .2s ease;
  }

  .floating-btn:hover,
  .share-menu a:hover,
  .share-menu button:hover {
    transform: translateY(-2px);
    background: rgba(37,99,235,.12);
  }

  .floating-btn svg,
  .share-menu svg {
    width: 19px;
    height: 19px;
    fill: currentColor;
  }

  .share-menu {
    display: flex;
    flex-direction: column;
    gap: 7px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: .2s ease;
  }

  .share-menu.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .back-top {
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
  }

  .back-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  @media (max-width: 600px) {
    .floating-share {
      right: 12px;
      bottom: 16px;
    }

    .floating-btn,
    .share-menu a,
    .share-menu button {
      width: 40px;
      height: 40px;
      border-radius: 11px;
    }

    .floating-btn svg,
    .share-menu svg {
      width: 17px;
      height: 17px;
    }
  }
</style>
