---
import "../styles/global.css";
import "../styles/global2.css";
import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import RelatedTools from "../components/RelatedTools.astro";
import { generateFaqSchema } from "../lib/faq-schema";
import { homeSchema } from "../lib/home-schema";
import ShareButtons from "../components/ShareButtons.astro";

const {
  title,
  description,
  canonical,
  html = "",
  articleSchema,
  breadcrumbs,
  amp,
  slug,
  isHome = false,
  pageCSS = [],
  robots = "index,follow,max-image-preview:large",
  lang = "id"
} = Astro.props;

const pathname = Astro.url.pathname;

const enableShare =
  pathname.startsWith("/blog/") ||
  pathname.startsWith("/tools/") ||
  pathname.startsWith("/product/");

const autoPageCSS = [...pageCSS];

/* =========================================
   AUTO CSS UNTUK SEMUA HALAMAN TOOLS
========================================= */

if (
  pathname.startsWith("/tools") &&
  !autoPageCSS.includes("tools")
) {
  autoPageCSS.push("tools");
}

/* =========================================
   DETEKSI DETAIL TOOL
   FORMAT BARU:
   /tools/{slug}/
========================================= */

const segments = pathname
  .split("/")
  .filter(Boolean);

const isToolPage =
  segments[0] === "tools" &&
  segments.length === 3;

/* =========================================
   AUTO BREADCRUMBS TOOLS
========================================= */

const autoBreadcrumbs =
  breadcrumbs ??
  (
    pathname.startsWith("/tools")
      ? (() => {
          const parts = pathname
            .split("/")
            .filter(Boolean);

          const items = [
            {
              name: "Home",
              url: "/"
            }
          ];

          let path = "";

          for (const part of parts) {
            path += `/${part}`;

            items.push({
              name: part
                .replace(/-/g, " ")
                .replace(/\b\w/g, c => c.toUpperCase()),
              url: `${path}/`
            });
          }

          return items;
        })()
      : breadcrumbs
  );

/* =========================================
   FAQ SCHEMA
========================================= */

const faqSchema = generateFaqSchema(html);
---

<!doctype html>
<html lang={lang}>

<head>

  <SeoHead
    title={title}
    description={description}
    canonical={canonical}
    articleSchema={articleSchema}
    breadcrumbs={autoBreadcrumbs}
    faqSchema={faqSchema}
    amp={amp}
    slug={slug}
    isHome={isHome}
    robots={robots}
    lang={lang}
  />

  {
    autoPageCSS.map(css => (
      <link
        rel="stylesheet"
        href={`/styles/${css}.css`}
      />
    ))
  }

  {
    isHome && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(homeSchema)}
      />
    )
  }

  <script is:inline>
    if (localStorage.getItem("theme") === "light") {
      document.documentElement.classList.add("light-mode");
    }
  </script>

</head>

<body>

  <Header />

  <main>

    <!-- =====================================
         BREADCRUMB TOOLS
    ====================================== -->

    {
      pathname.startsWith("/tools") &&
      autoBreadcrumbs &&
      autoBreadcrumbs.length > 1 && (
        <nav
          class="breadcrumb"
          aria-label="Breadcrumb"
        >

          {
            autoBreadcrumbs.map((item, index) => (
              <>
                {index > 0 && (
                  <span class="separator">
                    /
                  </span>
                )}

                {
                  index === autoBreadcrumbs.length - 1 ? (
                    <span aria-current="page">
                      {item.name}
                    </span>
                  ) : (
                    <a href={item.url}>
                      {item.name}
                    </a>
                  )
                }
              </>
            ))
          }

        </nav>
      )
    }

    <!-- =====================================
         CONTENT HALAMAN
    ====================================== -->

    <slot />

{enableShare && <ShareButtons title={title} />}

    <!-- =====================================
         RELATED TOOLS
         HANYA HALAMAN DETAIL TOOL
         /tools/{slug}/
    ====================================== -->

    {
      isToolPage && (
        <RelatedTools />
      )
    }

  </main>

  <Footer />

  <!-- =====================================
       THEME
  ====================================== -->

  <script is:inline>

    const html =
      document.documentElement;

    const themeBtn =
      document.getElementById("themeToggle");

    if (
      localStorage.getItem("theme") === "light"
    ) {
      html.classList.add("light-mode");
    }

    themeBtn?.addEventListener(
      "click",
      () => {

        html.classList.toggle(
          "light-mode"
        );

        localStorage.setItem(
          "theme",
          html.classList.contains("light-mode")
            ? "light"
            : "dark"
        );

      }
    );

  </script>

  <!-- =====================================
       MENU + FAQ
  ====================================== -->

  <script is:inline>

    function openMenu() {

      document
        .getElementById("mobileMenu")
        ?.classList.add("active");

    }

    function closeMenu() {

      document
        .getElementById("mobileMenu")
        ?.classList.remove("active");

    }

    /* FAQ */

    const faqItems =
      document.querySelectorAll(
        ".faq-item"
      );

    faqItems.forEach(item => {

      const question =
        item.querySelector(
          ".faq-question"
        );

      question?.addEventListener(
        "click",
        () => {

          item.classList.toggle(
            "active"
          );

        }
      );

    });

  </script>

</body>

</html>

